# Mac system files
.DS_Store

# Logs and temporary files
*.log
*.tmp

# Settings of each machine
.env

# Generated exports (PDFs, web version and screenshots)
slides/production/

# Build and compiled class files
code/**/*.class
code/**/build/
code/**/out/

# IDE files
code/.idea/
code/**/*.iml

# Javadoc generated from the code
code/**/doc/

# Gradle build cache
code/.gradle/

# Java backup files
code/**/*~
code/**/*.bak

# JetBrains Academy remote metadata and creator state
code/**/lesson-remote-info.yaml
code/**/task-remote-info.yaml
code/.coursecreator/
