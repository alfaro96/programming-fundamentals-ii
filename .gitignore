# Mac system files
.DS_Store

# Logs and temporary files
*.log
*.tmp

# Settings of each machine
.env

# slides: generated exports (PDFs, web version and published site)
slides/production/

# code: build and compiled class files
code/**/*.class
code/**/build/
code/**/out/

# code: IDE files
code/.idea/
code/**/*.iml

# code: documentation
code/doc/

# code: Gradle build cache
code/.gradle/

# code: Java backup files
code/**/*~
code/**/*.bak

# code: JetBrains Academy remote metadata and creator state
code/**/lesson-remote-info.yaml
code/**/task-remote-info.yaml
code/.coursecreator/
