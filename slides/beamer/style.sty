      \node[pf phone button text, text=colorBehavior] at ({\pf@W/2},\pf@deviceset) {Its own operation};
    \else
      \fill[colorHeading!6!colorBg, rounded corners=0.25\pf@u] (0.35,-3.95) rectangle (\pf@W-0.35,\pf@devicepanel);
      \node[pf phone text, text=colorMuted, font=\pf@phfont{0.22}{1}] at (0.6,-4.4) {\pf@dv@label};
      \node[pf phone text, text=pf@data, font=\pf@phfont{0.5}{1}\bfseries] at (0.6,-5.0) {\pf@dv@value};
      \ifx\pf@dv@bar\@empty\else
        \fill[colorHeading!15!colorBg, rounded corners=0.06\pf@u]
          (0.6,-5.2) rectangle (\pf@W-0.6,-5.2-\pf@devicebar);
        \ifx\pf@dv@barto\@empty
          \fill[pf@data, rounded corners=0.06\pf@u] (0.6,-5.2) rectangle ({0.6+(\pf@W-1.2)*\pf@dv@bar/100},-5.2-\pf@devicebar);
        \else
          \fill[pf@data, rounded corners=0.06\pf@u, visible on=<-\the\numexpr\pf@dv@baron-1\relax| handout:0>]
            (0.6,-5.2) rectangle ({0.6+(\pf@W-1.2)*\pf@dv@bar/100},-5.2-\pf@devicebar);
          \fill[colorAccent, rounded corners=0.06\pf@u, visible on=<\pf@dv@baron->]
            (0.6,-5.2) rectangle ({0.6+(\pf@W-1.2)*\pf@dv@barto/100},-5.2-\pf@devicebar);
        \fi
      \fi
    \fi
    % The buttons every device shares, and the one that sets its own value
    \pf@devicebutton{0.35}{\pf@W/2-0.1}{\pf@devicebuttons}{fill}{Turn on}%
    \pf@devicebutton{\pf@W/2+0.1}{\pf@W-0.35}{\pf@devicebuttons}{}{Turn off}%
    \ifx\pf@dv@set\@empty\else
      \pf@devicebutton{0.35}{\pf@W-0.35}{\pf@deviceset}{}{\pf@dv@set}%
      \ifx\pf@dv@tapon\@empty\else % pressed: the color of operations, what a tap on it runs
        \begin{scope}[visible on=<\pf@dv@tapon>]
          \colorlet{pf@button}{colorBehavior}\pf@devicebutton{0.35}{\pf@W-0.35}{\pf@deviceset}{fill}{\pf@dv@set}%
        \end{scope}%
      \fi
    \fi
    % The marks, just outside the screen
    \ifx\pf@dv@datamark\@empty\else
      \node[pf mark=\pf@phonescale*0.6, fill=tone@state, anchor=west, visible on=<\pf@dv@datamarkon>]
        at (\pf@W+0.25,-3.15) {\pf@dv@datamark}; % between its name and whether it is on
    \fi
    \ifx\pf@dv@opsmark\@empty\else
      \node[pf mark=\pf@phonescale*0.6, fill=tone@behavior, anchor=west, visible on=<\pf@dv@opsmarkon>]
        at (\pf@W+0.25,\pf@devicebuttons) {\pf@dv@opsmark};
    \fi
    \ifx\pf@dv@owndatamark\@empty\else
      \node[pf mark=\pf@phonescale*0.6, fill=tone@\pf@dv@owndatatone, anchor=west, visible on=<\pf@dv@owndatamarkon>]
        at (\pf@W+0.25,{(-3.95+\pf@devicepanel)/2}) {\pf@dv@owndatamark};
    \fi
    \ifx\pf@dv@ownopmark\@empty\else
      \node[pf mark=\pf@phonescale*0.6, fill=tone@\pf@dv@ownoptone, anchor=west, visible on=<\pf@dv@ownopmarkon>]
        at (\pf@W+0.25,\pf@deviceset) {\pf@dv@ownopmark};
    \fi
  \end{tikzpicture}%
  \endgroup}

