      \node[inner sep=0pt, text=colorState, font=\pf@phfont{0.22}{1}\bfseries]
        at ({\pf@W/2},{(-3.95+\pf@devicepanel)/2}) {Its own data};
      % and, under the shared buttons, where each kind's own button goes
