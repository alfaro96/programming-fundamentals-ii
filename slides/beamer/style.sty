  \global\pf@phonefirstfalse}

% % % % % % % % % % Memory diagrams % % % % % % % % % %
% \begin{memory}[rows] ... \end{memory}: the stack, with the variables of the method that runs, next to
% the heap, with the objects; rows, the stack's rows. Both frames are as tall as the taller of the two,
% the stack or what the heap holds, and both are centered in it. On a row of the stack:
% \memvar<step>{row}{name}{value}, a value held in the variable; \memref<step>[type]{row}{name}{address}{object},
% a reference, with an arrow to the object (and the variable's type over its cell, when it is not the object's class);
% \memref* bends its arrow halfway between the frames to the middle of the object, so several reach it at one point; \memnull<step>{row}{name}, a reference to none. In the heap,
% each named before the arrows that reach it: \memobject<step>{name}{row}{Class}{field/value, ...}, from
% that row down; \memstring<step>{name}{first row}{last row}{text}, a String across those rows
\newcommand\pf@memsize{0.56} % the text, em of the slide
\newcommand\pf@memrow{1.5} % a row of the stack, em of the slide
\newcommand\pf@mempad{0.55}
\newcommand\pf@memstackwidth{7.4}
\newcommand\pf@memheapwidth{10.6}
\newcommand\pf@memgap{1.8} % stack to heap
\newcommand\pf@memcellwidth{3.1}
\newcommand\pf@memcellheight{0.95}
\newcommand\pf@memtitlegap{0.3} % the frames to Stack and Heap, from their baseline
\newcommand\pf@memclassgap{0.3} % an object's class to the object, over it
\newcommand\pf@memnulllength{0.9}
\newcommand\pf@memrows{3}
\tikzset{
  pf mem cell/.style={draw=colorCodeEdge, fill=colorBg, line width=\pf@hairline, rounded corners=\pf@smallradius,
    minimum width=\slideem{\pf@memcellwidth}, minimum height=\slideem{\pf@memcellheight}, inner sep=0pt,
    font=\slidefont{\pf@memsize}{1.2}\ttfamily, text=colorText},
  pf mem name/.style={inner sep=0pt, font=\slidefont{\pf@memsize}{1.2}\ttfamily, text=colorText},
  pf mem arrow/.style={draw=colorText!70, line width=\pf@arrowline, -{Latex[round, length=\the\pf@flowheadlength]}},
  pf mem class/.style={inner sep=0pt, font=\slidefont{\pf@memsize}{1.2}\ttfamily\bfseries, text=colorHeading},
  pf mem object/.style={draw=colorHeading!40!colorBg, fill=colorHeading!5!colorBg, line width=\pf@hairline,
