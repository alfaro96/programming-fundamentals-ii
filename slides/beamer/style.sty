% An object: a row per attribute (its class goes over it, as a label)
\cs_new_protected:Npn \__pf_mem_object:nn #1#2
  {
    \tl_clear:N \l_tmpa_tl
    \clist_map_inline:nn {#2}
      {
        \seq_set_split:Nnn \l_tmpb_seq { / } {##1}
        \tl_if_empty:NF \l_tmpa_tl { \tl_put_right:Nn \l_tmpa_tl { \\ } } % between rows
        \tl_put_right:Nx \l_tmpa_tl
          {
            \seq_item:Nn \l_tmpb_seq { 1 } &
            \exp_not:N \tikz [ baseline = (pf@c.base) ] \exp_not:N \node [ pf~mem~cell ] ~ (pf@c) ~
              { \seq_item:Nn \l_tmpb_seq { 2 } } ; % in x, an item comes back unexpanded
