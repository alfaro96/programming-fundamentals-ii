% \devicephone[keys]: the home app's screen for one device, the running example of unit 3, in the same
% phones row. The keys, all optional: icon (light, thermostat or speaker), kind, name, power (On or Off),
% label, value and bar (its level, 0 to 100, as a bar under the value; bar to moves it on the step bar
% on, a number), set (the label of the button that sets it); template, the screen every device shares, with slots
% for its data and dashed boxes for what each kind adds, its data and its button; tones, as \phone's; tap on (the set button
% pressed); data mark, operations mark, own data mark and own operation mark, with their ... on steps,
% numbered discs by the shared data, the shared buttons, and each kind's own data and own button (own data tone
% and own operation tone, state and behavior unless given, for a note of another tone)
\pgfkeys{/pf/device/.is family, /pf/device,
  icon/.store in=\pf@dv@icon, kind/.store in=\pf@dv@kind, name/.store in=\pf@dv@name,
  power/.store in=\pf@dv@power, label/.store in=\pf@dv@label, value/.store in=\pf@dv@value,
  bar/.store in=\pf@dv@bar, bar to/.store in=\pf@dv@barto, bar on/.store in=\pf@dv@baron,
  set/.store in=\pf@dv@set, tap on/.store in=\pf@dv@tapon,
  template/.code={\let\ifpf@dv@template\iftrue\let\ifpf@dv@tones\iftrue}, tones/.code={\let\ifpf@dv@tones\iftrue},
  data mark/.store in=\pf@dv@datamark, data mark on/.store in=\pf@dv@datamarkon,
  operations mark/.store in=\pf@dv@opsmark, operations mark on/.store in=\pf@dv@opsmarkon,
  own data mark/.store in=\pf@dv@owndatamark, own data mark on/.store in=\pf@dv@owndatamarkon,
  own operation mark/.store in=\pf@dv@ownopmark, own operation mark on/.store in=\pf@dv@ownopmarkon,
  own data tone/.store in=\pf@dv@owndatatone, own operation tone/.store in=\pf@dv@ownoptone}
\newcommand\pf@devicedefaults{%
  \let\ifpf@dv@template\iffalse\let\ifpf@dv@tones\iffalse
  \def\pf@dv@icon{}\def\pf@dv@kind{Device}\def\pf@dv@name{}\def\pf@dv@power{Off}\def\pf@dv@label{}%
  \def\pf@dv@value{}\def\pf@dv@bar{}\def\pf@dv@barto{}\def\pf@dv@baron{2}\def\pf@dv@set{}\def\pf@dv@tapon{}%
  \def\pf@dv@datamark{}\def\pf@dv@datamarkon{1-}\def\pf@dv@opsmark{}\def\pf@dv@opsmarkon{1-}%
  \def\pf@dv@owndatamark{}\def\pf@dv@owndatamarkon{1-}\def\pf@dv@ownopmark{}\def\pf@dv@ownopmarkon{1-}%
  \def\pf@dv@owndatatone{state}\def\pf@dv@ownoptone{behavior}}
\newcommand\pf@devicebar{0.12} % the level bar's height, in units
\newcommand\pf@devicepanel{-5.6} % the bottom of the panel with the device's own value, in units
\newcommand\pf@devicebuttons{-6.45} % the middle of the Turn on and Turn off buttons
\newcommand\pf@deviceset{-7.4} % the middle of the wide button that sets its value
% An icon of #1 (light, thermostat or speaker) in the current color, centered on the origin, in units
\newcommand\pf@deviceicon[1]{\csname pf@deviceicon@#1\endcsname}
\newcommand\pf@deviceicon@light{%
  \fill (0,0.06) circle (0.16);
  \fill[rounded corners=0.02\pf@u] (-0.08,-0.22) rectangle (0.08,-0.08);}
\newcommand\pf@deviceicon@thermostat{%
  \fill[rounded corners=0.05\pf@u] (-0.05,-0.08) rectangle (0.05,0.24);
  \fill (0,-0.12) circle (0.1);}
\newcommand\pf@deviceicon@speaker{%
  \fill (-0.19,-0.07) rectangle (-0.09,0.07);
  \fill (-0.09,0.07) -- (0.03,0.17) -- (0.03,-0.17) -- (-0.09,-0.07) -- cycle;
  \draw[line width=0.03\pf@u] (0.09,-0.08) arc[start angle=-40, end angle=40, radius=0.125];}
% A button between #1 and #2 across, at #3 down: filled (#4 = fill) or outlined, with the text #5
\newcommand\pf@devicebutton[5]{%
  \ifx\relax#4\relax
    \draw[pf@button, line width=0.04\pf@u, rounded corners=0.36\pf@u] (#1,#3+0.36) rectangle (#2,#3-0.36);
    \node[pf phone button text, text=pf@button] at ({(#1+#2)/2},#3) {#5};
  \else % its outline too, so a pressed button over an outlined one covers it whole
    \filldraw[pf@button, line width=0.04\pf@u, rounded corners=0.36\pf@u] (#1,#3+0.36) rectangle (#2,#3-0.36);
    \node[pf phone button text, text=colorBg] at ({(#1+#2)/2},#3) {#5};
  \fi}
\NewDocumentCommand\devicephone{ O{} }{%
  \pf@phonesep
  \begingroup\pf@devicedefaults\pgfkeys{/pf/device,#1}%
  \begin{tikzpicture}[x=\pf@u, y=\pf@u, baseline={-\pf@phoneheight\pf@u}]
    \pgfmathsetmacro\pf@W{\pf@phonewidth}\pgfmathsetmacro\pf@H{\pf@phoneheight}%
    \pf@phoneshell
    \ifpf@dv@tones\colorlet{pf@data}{colorState}\colorlet{pf@photo}{colorState}\colorlet{pf@button}{colorBehavior}%
    \else\colorlet{pf@data}{colorText}\colorlet{pf@photo}{colorHeading}\colorlet{pf@button}{colorHeading}\fi
    % The device: its icon, its kind, its name and whether it is on
    \ifpf@dv@template
      \draw[colorState!60!colorBg, line width=0.025\pf@u, fill=colorState!8!colorBg] (0.92,-1.45) circle (0.42);
    \else
      \fill[pf@photo!12!colorBg] (0.92,-1.45) circle (0.42);
      \ifx\pf@dv@icon\@empty\else\begin{scope}[shift={(0.92,-1.45)}, pf@photo]\pf@deviceicon{\pf@dv@icon}\end{scope}\fi
    \fi
    \node[pf phone text, text=colorMuted, font=\pf@phfont{0.26}{1}] at (0.5,-2.35) {\pf@dv@kind};
    \ifpf@dv@template
      \pf@phoneslot{(0.5,-2.95)}{Name}{\pf@phfont{0.3}{1}\bfseries}%
      \pf@phoneslot{(0.5,-3.5)}{Status}{\pf@phfont{0.24}{1}\bfseries}%
    \else
      \node[pf phone text, text=pf@data, font=\pf@phfont{0.3}{1}\bfseries] at (0.5,-2.95) {\pf@dv@name};
      \def\pf@on{On}%
      \ifx\pf@dv@power\pf@on\colorlet{pf@power}{tone@ok}\else\colorlet{pf@power}{colorMuted}\fi
      \ifpf@dv@tones\colorlet{pf@power}{pf@data}\fi
      \node[pf phone text, text=pf@power, font=\pf@phfont{0.24}{1}\bfseries] at (0.5,-3.5) {\pf@dv@power};
    \fi
    % Its own part: the panel with its value, and the button that sets it; in the template, a dashed box
    \ifpf@dv@template
