\int_new:N \l__pf_from_int
\int_new:N \l__pf_step_int
\tl_new:N \l__pf_path_tl
\tl_new:N \l__pf_first_tl
\tl_new:N \l__pf_last_tl
\bool_new:N \l__pf_dim_bool
\dim_new:N \l__pf_size_dim
\dim_new:N \l__pf_pady_dim
\dim_new:N \l__pf_padx_dim
\dim_new:N \l__pf_line_dim
\clist_new:N \l__pf_marks_clist
\seq_new:N \l__pf_lines_seq
\int_new:N \l__pf_mark_int
\int_new:N \l__pf_markfrom_int
\clist_new:N \l__pf_strikes_clist
\clist_new:N \l__pf_adds_clist
