% % % % % % % % % % Widening chain % % % % % % % % % %
% \widening<2-><3->{byte, short, int}{Widening title}{its sentence}{Narrowing title}{its sentence}: the
% types in a row, joined by a widening arrow to the right (teal, from the first step) over a narrowing
% one to the left (orange, from the second); each explained in its color, over and under the chain
\newcommand\pf@wideningsize{0.9}
\newcommand\pf@wideninggap{0.6} % type to arrow, em of the chain
\newcommand\pf@wideninglength{2} % em of the chain
\newcommand\pf@wideningarrowgap{0.7} % between the two arrows of a pair, em of the chain
\newcommand\pf@wideninglabelgap{1.2} % the chain to the text over and under it, em of the slide
\newcommand\pf@wideningtextgap{0.1} % a title to its sentence, beyond the sentence's line height, em of the slide
\newcommand\pf@wideningtitlesize{0.7}
\newcommand\pf@wideningtextsize{0.58}

% A title in #1 over its sentence, centered: the text of each side of the chain; its node sets the
% sentence's font, so the line break takes the sentence's line height, not the chain's
\newcommand\pf@wideninglabel[3]{%
  {\slidefont{\pf@wideningtitlesize}{1.2}\bfseries\color{#1}#2}\\[\slideem{\pf@wideningtextgap}]%
  {\slidefont{\pf@wideningtextsize}{1.35}\color{colorText}#3}}

\ExplSyntaxOn
\seq_new:N \l__pf_widening_seq
\NewDocumentCommand \widening { D<>{1-} D<>{1-} m m m m m }
  {
    \seq_set_from_clist:Nn \l__pf_widening_seq {#3}
    \par
    \begin{center}
    \slidefont{\pf@wideningsize}{1.2}
    \begin{tikzpicture}[every~node/.style={inner~sep=0pt, text=colorCodeKeyword, font=\ttfamily}]
      \node (t1) at (0,0) {\seq_item:Nn \l__pf_widening_seq { 1 }};
      \int_step_inline:nnn { 2 } { \seq_count:N \l__pf_widening_seq }
        {
          \node[anchor=base~west] (t##1) at ([xshift=\slideem{(2*\pf@wideninggap+\pf@wideninglength)*\pf@wideningsize}]t\int_eval:n{##1-1}.base~east)
            {\seq_item:Nn \l__pf_widening_seq {##1}};
          \draw[flow~arrow, draw=colorAccentTwo, visible~on=<#1>]
            ([xshift=\slideem{\pf@wideninggap*\pf@wideningsize}, yshift=\slideem{(0.3+\pf@wideningarrowgap/2)*\pf@wideningsize}]t\int_eval:n{##1-1}.base~east)
            -- ++(\slideem{\pf@wideninglength*\pf@wideningsize},0);
          \draw[flow~arrow, draw=paletteOrange, visible~on=<#2>]
            ([xshift=-\slideem{\pf@wideninggap*\pf@wideningsize}, yshift=\slideem{(0.3-\pf@wideningarrowgap/2)*\pf@wideningsize}]t##1.base~west)
            -- ++(-\slideem{\pf@wideninglength*\pf@wideningsize},0);
        }
      \coordinate (pf@chaintop) at (current~bounding~box.north);
      \coordinate (pf@chainbottom) at (current~bounding~box.south);
      \node[anchor=south, align=center, font=\normalfont\slidefont{\pf@wideningtextsize}{1.35}, visible~on=<#1>]
        at ([yshift=\slideem{\pf@wideninglabelgap}]pf@chaintop) {\pf@wideninglabel{colorAccentTwo}{#4}{#5}};
      \node[anchor=north, align=center, font=\normalfont\slidefont{\pf@wideningtextsize}{1.35}, visible~on=<#2>]
        at ([yshift=-\slideem{\pf@wideninglabelgap}]pf@chainbottom) {\pf@wideninglabel{paletteOrange}{#6}{#7}};
    \end{tikzpicture}
    \end{center}
  }
