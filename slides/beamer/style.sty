      \node[pf mem class, anchor=south] at ([yshift=\slideem{\pf@memclassgap}]pf@memcell.north) {#3};\fi
    \IfBooleanTF{#1}
      {\draw[pf mem arrow] (pf@memcell.east) -- (\slideem{\pf@memstackwidth+\pf@memgap/2},0 |- pf@memcell.east)
         |- (pf@mem@#7.west);}% bent, halfway between the frames, to the middle of the object
      {\draw[pf mem arrow] (pf@memcell.east) -- (pf@memcell.east -| pf@mem@#7.west);}
  \end{scope}\fi}
