  basicstyle=\slidefont{\pf@codesizenow}{\pf@codelineheight}\ttfamily\color{colorText}\pf@linegrid,
  columns=fullflexible, keepspaces=true, showstringspaces=false, upquote=true, tabsize=4,
  aboveskip=0pt, belowskip=0pt, lineskip=0pt}

\lstdefinestyle{pf code}{
