% The body runs twice: the first time it only measures what the heap holds (\ifpf@memmeasure), from the
% top of the rows down (\pf@memtop to \pf@memlow), so the second can draw the frames and center both
% sides in them, each shifted by its own \pf@mem...shift
\newif\ifpf@memmeasure
\newdimen\pf@memtop \newdimen\pf@memlow \newdimen\pf@memheight
\newdimen\pf@memstackshift \newdimen\pf@memheapshift
\newdimen\pf@memtypeover % how far a type over the first row's cell rises above the rows
\newdimen\pf@memstackheight
\newbox\pf@memtypebox
\newcommand\pf@memextent[2]{% a heap item from #1 to #2 below the top of the rows
  \ifdim\dimexpr#1\relax<\pf@memtop\global\pf@memtop=\dimexpr#1\relax\fi
  \ifdim\dimexpr#2\relax>\pf@memlow\global\pf@memlow=\dimexpr#2\relax\fi}
\newcommand\pf@memy[1]{\the\dimexpr-\slideem{\pf@mempad+(#1-0.5)*\pf@memrow}-\pf@memstackshift\relax} % a row's middle
\newcommand\pf@memheapy[1]{\the\dimexpr-\slideem{\pf@mempad}-(#1)-\pf@memheapshift\relax} % #1 below the top of the rows
\NewDocumentEnvironment{memory}{ O{3} +b }{%
  \def\pf@memrows{#1}
  \begin{tikzpicture}[font=\slidefont{\pf@memsize}{1.2}]
    \global\pf@memtop=\maxdimen\global\pf@memlow=-\maxdimen\global\pf@memtypeover=0pt
    \pf@memmeasuretrue#2\pf@memmeasurefalse
    \ifdim\pf@memtop=\maxdimen\global\pf@memtop=0pt\global\pf@memlow=0pt\fi % an empty heap
    % The stack's rows; with a type over the first cell, from that type to the last cell, as the heap's objects
    % count from their class, so a variable and its object line up when both have a label over them
    \pf@memstackheight=\slideem{\pf@memrows*\pf@memrow}%
    \ifdim\pf@memtypeover>0pt
      \pf@memstackheight=\dimexpr\pf@memstackheight-\slideem{(\pf@memrow-\pf@memcellheight)/2}+\pf@memtypeover\relax\fi
    \pf@memheight=\dimexpr\pf@memlow-\pf@memtop\relax
    \ifdim\pf@memheight<\pf@memstackheight\pf@memheight=\pf@memstackheight\fi
    \pf@memheapshift=\dimexpr(\pf@memheight-\pf@memlow+\pf@memtop)/2-\pf@memtop\relax
    \pf@memstackshift=\dimexpr(\pf@memheight-\pf@memstackheight)/2+\pf@memtypeover\relax
    \pgfmathsetlengthmacro\pf@membottom{-\pf@memheight-\slideem{2*\pf@mempad}}%
    \draw[draw=colorCodeEdge, line width=\pf@hairline, rounded corners=\pf@radius]
      (0,0) rectangle (\slideem{\pf@memstackwidth},\pf@membottom);
    \draw[draw=colorCodeEdge, line width=\pf@hairline, rounded corners=\pf@radius]
      (\slideem{\pf@memstackwidth+\pf@memgap},0) rectangle (\slideem{\pf@memstackwidth+\pf@memgap+\pf@memheapwidth},\pf@membottom);
    % On their baseline, so the p of Heap does not lift it
    \node[anchor=base, inner sep=0pt, font=\slidefont{\pf@ruletitlesize}{1.2}\bfseries, text=colorHeading]
      at (\slideem{\pf@memstackwidth/2},\slideem{\pf@memtitlegap}) {Stack};
    \node[anchor=base, inner sep=0pt, font=\slidefont{\pf@ruletitlesize}{1.2}\bfseries, text=colorHeading]
      at (\slideem{\pf@memstackwidth+\pf@memgap+\pf@memheapwidth/2},\slideem{\pf@memtitlegap}) {Heap};
    #2
  \end{tikzpicture}}{}
% The variable's name and its cell, on a row
\newcommand\pf@memcell[4]{% #1 row, #2 name, #3 value, #4 extra cell style
  \node[pf mem name, anchor=west] at (\slideem{\pf@mempad},\pf@memy{#1}) {#2};
  \node[pf mem cell, anchor=east, #4] (pf@memcell) at (\slideem{\pf@memstackwidth-\pf@mempad},\pf@memy{#1}) {#3};}
\NewDocumentCommand\memvar{ D<>{1-} m m m }{\ifpf@memmeasure\else
  \begin{scope}[visible on=<#1>]\pf@memcell{#2}{#3}{#4}{}\end{scope}\fi}
\newcommand\memnullvalue{\textcolor{colorMuted}{null}} % an attribute of an object that refers to nothing
\NewDocumentCommand\memnull{ D<>{1-} m m }{\ifpf@memmeasure\else
  \begin{scope}[visible on=<#1>]
    \pf@memcell{#2}{#3}{null}{text=colorMuted}
    \draw[draw=colorMuted, line width=\pf@arrowline, dashed] (pf@memcell.east) -- ++(\slideem{\pf@memnulllength},0) coordinate (pf@memend);
    \draw[draw=colorMuted, line width=\pf@arrowline] ([yshift=\slideem{0.25}]pf@memend) -- ([yshift=-\slideem{0.25}]pf@memend);
  \end{scope}\fi}
\NewDocumentCommand\memref{ s D<>{1-} O{} m m m m }{\ifpf@memmeasure
