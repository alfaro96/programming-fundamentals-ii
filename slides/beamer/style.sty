% % % % % % % % % % Class diagrams % % % % % % % % % %
% \begin{classdiagram} \classbox<step>{id}{column}{superclass}{Class}{attributes}{methods} ... \end{classdiagram}:
% classes drawn as in UML, the name over its attributes (name: Type, in the tone of data) and its methods
% (name(Types): Type, of operations), left-aligned, each part only if it has something, comma lists one per line. A class with a superclass's id sits under it,
% with the hollow-headed arrow to it; column places it across, in columns (0, 1, 2, or 0.5 between them)
\newcommand\pf@classsize{0.36} % the text, em of the slide
\newcommand\pf@classcolumn{7.4} % between the centers of two columns, em of the slide: room for a typed method
\newcommand\pf@classgap{2.6} % a class to its subclasses, em of the slide: room for the arrows and their disc
\newcommand\pf@classminwidth{4} % the narrowest box, em of the slide
\newcommand\pf@classpadx{0.4}
\newcommand\pf@classpady{0.28}
\newcommand\pf@classhead{0.55} % the open arrowhead of inheritance, em of the slide
\tikzset{
  pf class part/.style={inner xsep=\slideem{\pf@classpadx}, inner ysep=\slideem{\pf@classpady}, outer sep=0pt,
    text width=\pf@classtextwidth, align=left, anchor=north, font=\slidefont{\pf@classsize}{1.35}\ttfamily},
  pf class box/.style={draw=colorHeading!40!colorBg, fill=colorHeading!5!colorBg, line width=\pf@hairline,
    rounded corners=\pf@radius, inner sep=0pt},
  pf inherits/.style={draw=colorText!70, line width=\pf@arrowline, % an arrow tip takes no \dimexpr: its size, worked out
    -{Triangle[open, length=\pf@classheadlength, width=\pf@classheadlength]}}}
\edef\pf@classheadlength{\the\slideem{\pf@classhead}}
\newcount\pf@classdiagram % each diagram drawn, every step of a frame included, so its classes' facts are its own
\NewDocumentEnvironment{classdiagram}{ +b }{%
  \global\advance\pf@classdiagram by 1
  \begin{tikzpicture}#1\end{tikzpicture}}{}
% \classmark<step>[tone]{above or below}{id}{number}: a numbered disc over or under a class's box, centered, for the
% notes beside the diagram (above for a superclass, whose arrows leave from its bottom); \inheritmark<step>[tone]
% {subclass}{number}, the same right of the arrow that leaves the subclass, halfway up to where it turns, or of the
% line up to the arrowhead if it is the only subclass, its arrow then straight
\newcommand\pf@classmarksize{\pf@ruletitlesize} % a disc, as the one of its note beside: one of a code size,
% first loaded here, would move the lines of the code blocks after it
\newcommand\pf@classmarkgap{0.2} % the box's edge, or the arrowhead, to its disc, em of the slide
\NewDocumentCommand\classmark{ D<>{1-} O{info} m m m }{%
  \node[pf mark=\pf@classmarksize, fill=tone@#2, visible on=<#1>, pf class mark #3=#4] {#5};}
\tikzset{
  pf class mark above/.style={anchor=south, at={([yshift=\slideem{\pf@classmarkgap}]pf@class@#1.north)}},
  pf class mark below/.style={anchor=north, at={([yshift=-\slideem{\pf@classmarkgap}]pf@class@#1.south)}}}
% \inheritmark* puts it over the stretch across that is that subclass's alone, from where its arrow turns to its
% superclass, for a subclass whose turn another arrow leaves from too (\classwrong)
\newcommand\pf@inheritmarkacross[4]{% step, tone, subclass, number
  \edef\pf@inheritsuper{\csname pf@cl@super@\the\pf@classdiagram @#3\endcsname}%
  \coordinate (pf@mid) at ($(pf@class@#3.north)!0.5!(pf@class@\pf@inheritsuper.south)$);
  \node[pf mark=\pf@classmarksize, fill=tone@#2, anchor=south, visible on=<#1>] at ([yshift=\slideem{\pf@classmarkgap}]
    $(pf@class@#3.north |- pf@mid)!0.5!(pf@class@\pf@inheritsuper.south |- pf@mid)$) {#4};}
\NewDocumentCommand\inheritmark{ s D<>{1-} O{info} m m }{%
  \IfBooleanTF{#1}{\pf@inheritmarkacross{#2}{#3}{#4}{#5}}{%
  \edef\pf@inheritrise{\ifnum\csname pf@cl@kids@\the\pf@classdiagram @\csname pf@cl@super@\the\pf@classdiagram
    @#4\endcsname\endcsname=1 (\pf@classgap-\pf@classhead)/2\else \pf@classgap/4\fi}% the line without its head
  % when straight, or the stretch down from where it turns
  \node[pf mark=\pf@classmarksize, fill=tone@#3, anchor=west, visible on=<#2>]
    at ([xshift=\slideem{\pf@classmarkgap}, yshift=\slideem{\pf@inheritrise}]pf@class@#4.north) {#5};}}
% \classwrong<step>[tone]{subclass}{superclass}{number}: an inheritance that is not allowed, dashed and in its tone
% (warn by default), from where the subclass's arrow turns to where the superclass's own arrow goes up, joining
% it, with a numbered disc over its middle
\newcommand\pf@classwrongdash{0.25} % the dashes, em of the slide
\NewDocumentCommand\classwrong{ D<>{1-} O{warn} m m m }{%
  \begin{scope}[visible on=<#1>]
    \coordinate (pf@mid) at ($(pf@class@#3.north)!0.5!(pf@class@#4.south)$);
    \draw[draw=tone@#2, line width=\pf@arrowline, dash pattern=on \slideem{\pf@classwrongdash} off \slideem{\pf@classwrongdash}]
      (pf@class@#3.north |- pf@mid) -- (pf@class@#4.south |- pf@mid);
    \node[pf mark=\pf@classmarksize, fill=tone@#2, anchor=south] at ([yshift=\slideem{\pf@classmarkgap}]
      $(pf@class@#3.north |- pf@mid)!0.5!(pf@class@#4.south |- pf@mid)$) {#5};
  \end{scope}}
\ExplSyntaxOn
\cs_new:Npn \pf@classlines #1 { \clist_use:nn {#1} { \strut \\ } \strut } % a comma list, a line each, all as tall
\ExplSyntaxOff
\newcommand\pf@ifblank[3]{\if\relax\detokenize{#1}\relax#2\else#3\fi}
\newsavebox\pf@classmeasure
\newlength\pf@classtextwidth
\newcommand\pf@classwiden[1]{% the parts' text width grows to the widest line of #1
  \pgfinterruptpicture % measured as outside the picture, where there is a font
    \global\setbox\pf@classmeasure\hbox{\slidefont{\pf@classsize}{1.35}\ttfamily\bfseries\begin{tabular}{@{}l@{}}#1\end{tabular}}%
  \endpgfinterruptpicture
  \ifdim\wd\pf@classmeasure>\pf@classtextwidth\setlength\pf@classtextwidth{\wd\pf@classmeasure}\fi}
% The name, attributes and methods of the class in \pf@cl@..., one node each, from pf@at down; #1, options for
% all of them: drawn first unseen, to know the box's size, then over the box, as a layer would keep none of
% the scope's step
\newcommand\pf@classparts[1]{%
  \node[pf class part, align=center, text=colorHeading, font=\slidefont{\pf@classsize}{1.35}\ttfamily\bfseries, #1]
    (pf@part) at (pf@at) {\strut\pf@cl@name};
  \coordinate (pf@first) at (pf@part.north west);
  \def\pf@classseps{}% the parts' borders, drawn across the whole box once its width is known
  \ifx\pf@cl@attributes\@empty\else
    \coordinate (pf@sepattributes) at (pf@part.south);\edef\pf@classseps{\pf@classseps,attributes}%
    \node[pf class part, text=colorState, #1] (pf@part) at (pf@part.south) {\expandafter\pf@classlines\expandafter{\pf@cl@attributes}};
  \fi
  \ifx\pf@cl@methods\@empty\else
    \coordinate (pf@sepmethods) at (pf@part.south);\edef\pf@classseps{\pf@classseps,methods}%
    \node[pf class part, text=colorBehavior, #1] (pf@part) at (pf@part.south) {\expandafter\pf@classlines\expandafter{\pf@cl@methods}};
  \fi}
% \classbox* is a class that implements the interface above it: its arrow dashed, as in UML; an interface's name
% is written \interfacename{List}, with the stereotype over it
\newcommand\interfacename[1]{{\mdseries\guillemotleft interface\guillemotright}\\#1}
% \classunused<step> right before a \classbox: from the step, the class and its arrow dim and a cross goes over its
% box, for a part of the hierarchy the course leaves aside
\def\pf@cl@unused{} % not \newcommand, whose \long would never match \@empty
\NewDocumentCommand\classunused{ D<>{1-} }{\gdef\pf@cl@unused{#1}}
\newcommand\pf@classimplementsdash{0.25} % the dashes of an arrow to an interface, em of the slide
\edef\pf@classdashlength{\the\slideem{\pf@classimplementsdash}} % a dash pattern takes no \dimexpr: worked out
\tikzset{pf implements/.style={dash pattern=on \pf@classdashlength\space off \pf@classdashlength},
  pf extends/.style={}}
\NewDocumentCommand\classbox{ s D<>{1-} m m m m m m }{%
  \IfBooleanTF{#1}{\def\pf@cl@arrow{pf implements}}{\def\pf@cl@arrow{pf extends}}%
  \pf@classboxbody{#2}{#3}{#4}{#5}{#6}{#7}{#8}}
\newcommand\pf@classboxbody[7]{%
  \def\pf@cl@id{#2}\def\pf@cl@name{#5}%
  \pf@ifblank{#4}{}{% its superclass, and how many subclasses that has, for \inheritmark; named after the diagram
    \expandafter\xdef\csname pf@cl@super@\the\pf@classdiagram @#2\endcsname{#4}%
    \edef\pf@kids{\the\numexpr\ifcsname pf@cl@kids@\the\pf@classdiagram @#4\endcsname % counted before naming it,
      \csname pf@cl@kids@\the\pf@classdiagram @#4\endcsname\else0\fi+1\relax}% which would make it \relax
    \expandafter\global\expandafter\let\csname pf@cl@kids@\the\pf@classdiagram @#4\endcsname\pf@kids}%
  \def\pf@cl@attributes{#6}\def\pf@cl@methods{#7}%
  \setlength\pf@classtextwidth{\dimexpr\slideem{\pf@classminwidth}-2\slideem{\pf@classpadx}\relax}%
  \pf@classwiden{#5}\pf@ifblank{#6}{}{\pf@classwiden{\pf@classlines{#6}}}\pf@ifblank{#7}{}{\pf@classwiden{\pf@classlines{#7}}}%
  \ifx\pf@cl@unused\@empty\tikzset{pf class state/.style={}}\else
    \edef\pf@tmp{\noexpand\tikzset{pf class state/.style={transparency group,
      alt={<\pf@cl@unused>{opacity=\pf@keywordunused}{}}}}}\pf@tmp\fi
  \begin{scope}[visible on=<#1>, pf class state]
    \pf@ifblank{#4}{\coordinate (pf@at) at (\slideem{#3*\pf@classcolumn},0);}
      {\path let \p1=(pf@class@#4.south) in coordinate (pf@at) at (\slideem{#3*\pf@classcolumn},\y1-\slideem{\pf@classgap});}
    \pf@classparts{text opacity=0}%
    \node[pf class box, fit=(pf@first)(pf@part.south east)] (pf@class@#2) {};
    \pf@classparts{}%
    \foreach \pf@sep in \pf@classseps {\ifx\pf@sep\@empty\else
      \draw[colorHeading!40!colorBg, line width=\pf@hairline]
        (pf@class@#2.west |- pf@sep\pf@sep) -- (pf@class@#2.east |- pf@sep\pf@sep);\fi}
    \pf@ifblank{#4}{}{%
      \coordinate (pf@mid) at ($(pf@class@#2.north)!0.5!(pf@class@#4.south)$);
      \draw[pf inherits, \pf@cl@arrow] (pf@class@#2.north) -- (pf@class@#2.north |- pf@mid) -| (pf@class@#4.south);}
    \ifx\pf@cl@unused\@empty\else
      \begin{scope}[visible on=<\pf@cl@unused>] % the cross, clipped to the inside of the box's border, round
        \clip[rounded corners=\pf@radius-0.5\pf@hairline] % corners too: the anchors lie half a border out
          ([shift={(\pf@hairline,-\pf@hairline)}]pf@class@#2.north west) rectangle
          ([shift={(-\pf@hairline,\pf@hairline)}]pf@class@#2.south east);
        \draw[paletteRed, line width=\pf@hairline]
          (pf@class@#2.north west) -- (pf@class@#2.south east) (pf@class@#2.north east) -- (pf@class@#2.south west);
      \end{scope}%
    \fi
  \end{scope}%
  \gdef\pf@cl@unused{}}

