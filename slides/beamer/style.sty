  keywordstyle=\color{colorCodeKeyword},
  keywordstyle={[2]\color{colorCodeAnnotation}},
  stringstyle=\color{colorCodeString},
  commentstyle=\color{colorMuted}\itshape,
  numbers=left, numberstyle=\color{colorMuted},
  numbersep=\slideem{\pf@codenumbergap*\pf@codesizenow},
  xleftmargin=\slideem{(\pf@codenumberwidth+\pf@codenumbergap)*\pf@codesizenow}}

\lstdefinelanguage{pfjava}[]{Java}{
