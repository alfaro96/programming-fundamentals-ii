  \fill[colorHeading!70!colorBg, rounded corners=0.08\pf@em] (0,-0.4) rectangle (1.1,0.32);
  \fill[colorHeading!70!colorBg, rounded corners=0.06\pf@em] (0,0.2) rectangle (0.45,0.45);}
\newcommand\pf@explorericon@java{% a page, in the color of code
  \fill[colorAccentTwo!80!colorBg, rounded corners=0.06\pf@em] (0.1,-0.5) rectangle (0.9,0.5);
  \fill[colorBg] (0.25,0.15) rectangle (0.75,0.22);
  \fill[colorBg] (0.25,-0.05) rectangle (0.75,0.02);
  \fill[colorBg] (0.25,-0.25) rectangle (0.6,-0.18);}

% % % % % % % % % % Question % % % % % % % % % %
% \question{Question}<step>{Follow-up}: a question to the class before a concept, on a frame of its own
% with no title, large and in the color of titles; the follow-up, optional, comes on its step
\newcommand\pf@questionsize{2} % em of the slide: alone on the slide, it fills it
\newcommand\pf@questionlineheight{1.3}
\newcommand\pf@questiongap{1.2} % the question to its follow-up, em of the question
\newcommand\pf@questionwidth{0.92} % of the text width, so a question breaks into balanced lines
\newcommand\pf@questiontext[1]{%
  \parbox[t]{\pf@questionwidth\textwidth}{\slidefont{\pf@questionsize}{\pf@questionlineheight}\bfseries
    \color{colorHeading}\raggedright\pf@nohyphens#1}\par}
\NewDocumentCommand\question{ m D<>{2-} g }{%
  \pf@questiontext{#1}%
  \IfValueT{#3}{\vskip\slideem{\pf@questiongap*\pf@questionsize}\uncover<#2>{\pf@questiontext{#3}}}%
  % In the middle of the slide: this fill and the frame's top one, as the bottom one is cancelled (as the
  % takeaway does)
  \par\vskip0pt plus 1fill\vskip-\beamer@framebottomskip}

% % % % % % % % % % Takeaway % % % % % % % % % %
% \takeaway<overlay>{Text}: highlighted and as wide as its text, at the bottom left of the slide
\newcommand\pf@takeawaygap{0.6} % the least room between the content and the takeaway, em of the slide
\tcbset{
  pf takeaway/.style={
    pf callout={colorAccent}{colorHighlightSoft}, hbox,
    left=\slideem{\pf@notepaddingx*\pf@notesize},
    right=\slideem{\pf@notepaddingx*\pf@notesize},
    top=\slideem{\pf@notepaddingy*\pf@notesize}, bottom=\slideem{\pf@notepaddingy*\pf@notesize}}}

\NewDocumentCommand\takeaway{ D<>{1-} m }{%
  % At the bottom: the glue after it cancels the frame's own bottom glue, and the fill before it
  % centers the content between title and takeaway, as beamer does (at the top with [t])
  \par\vskip\slideem{\pf@takeawaygap} plus 1fill
  \begin{uncoverenv}<#1>%
  \begin{tcolorbox}[pf takeaway]
    \begin{varwidth}{\dimexpr\linewidth-2\pf@hairline-2\slideem{\pf@notepaddingx*\pf@notesize}\relax}
      \slidefont{\pf@notesize}{\pf@lineheightbody}\color{colorText}\raggedright\pf@linegrid\pf@nohyphens#2
    \end{varwidth}
  \end{tcolorbox}%
  \end{uncoverenv}%
  \par\vskip-\beamer@framebottomskip}

