\tcbset{
  steps/.code = { \seq_set_split:Nnn \l__pf_steps_seq { | } {#1} },
  steps~from/.code = { \int_set:Nn \l__pf_from_int {#1} },
  dim/.code = { \use:c { bool_set_#1:N } \l__pf_dim_bool },
  marks/.code = { \clist_set:Nn \l__pf_marks_clist {#1} },
  marks~from/.code = { \int_set:Nn \l__pf_markfrom_int {#1} },
  lines/.code = { \seq_set_split:Nnn \l__pf_lines_seq { | } {#1} },
  strike/.code = { \clist_set:Nn \l__pf_strikes_clist {#1} },
  add/.code = { \clist_set:Nn \l__pf_adds_clist {#1} },
}

% The padding and line height of a block whose text is #1 slide ems, which the bands are measured in
\cs_new_protected:Npn \pf_code_setup:n #1
  {
    \dim_set:Nn \l__pf_size_dim { \fp_eval:n {#1} \pf@em }
    \dim_set:Nn \l__pf_pady_dim { \pf@codepaddingy \l__pf_size_dim }
    \dim_set:Nn \l__pf_padx_dim { \pf@codepaddingx \l__pf_size_dim }
    \dim_set:Nn \l__pf_line_dim { \pf@codelineheight \l__pf_size_dim }
    % A character's width, for strike: measured here, as in the picture there is no font
    \hbox_set:Nn \l_tmpa_box { \slidefont{#1}{\pf@codelineheight}\ttfamily 0 }
    \dim_set:Nn \l__pf_char_dim { \box_wd:N \l_tmpa_box }
  }

% A rectangle across the content, between two depths below the top of the frame's interior
\cs_new:Npn \__pf_rect:nn #1 #2
  {
    ([xshift=\dim_use:N \l__pf_padx_dim, yshift=#1]interior.north~west)~rectangle~
    ([xshift=-\dim_use:N \l__pf_padx_dim, yshift=#2]interior.north~east)~
  }

% Adds to the path the band of each range in the comma list #1 (3, 5-7); none marks no line
\cs_new_protected:Npn \__pf_add_ranges:n #1
  {
    \clist_map_inline:nn {#1}
      {
        \str_if_eq:nnF {##1} { none } { \__pf_add_range:n {##1} }
      }
  }
\cs_new_protected:Npn \__pf_add_range:n #1
  {
        \seq_set_split:Nnn \l_tmpb_seq { - } {#1}
        \tl_set:Nx \l__pf_first_tl { \seq_item:Nn \l_tmpb_seq { 1 } }
        \tl_set:Nx \l__pf_last_tl
          {
            \int_compare:nNnTF { \seq_count:N \l_tmpb_seq } > { 1 }
              { \seq_item:Nn \l_tmpb_seq { 2 } } { \l__pf_first_tl }
          }
        \tl_put_right:Nx \l__pf_path_tl
          {
            \__pf_rect:nn
              { \dim_eval:n { - \l__pf_pady_dim - \l__pf_line_dim * ( \l__pf_first_tl - 1 ) } }
              { \dim_eval:n { - \l__pf_pady_dim - \l__pf_line_dim * \l__pf_last_tl } }
          }
  }

% Draws #1 (fill options) over the path of each non-empty step, on that step's overlay only;
% #2 is true to start the path with the whole content, so the even-odd rule fades all but the bands
\cs_new_protected:Npn \__pf_draw_steps:nn #1 #2
  {
    \int_zero:N \l__pf_step_int
    \seq_map_inline:Nn \l__pf_steps_seq
      {
        \tl_if_blank:nF {##1}
          {
            \tl_clear:N \l__pf_path_tl
            \bool_if:nT {#2}
              {
                \tl_put_right:Nx \l__pf_path_tl
                  {
                    ([xshift=\dim_use:N \l__pf_padx_dim, yshift=-\dim_use:N \l__pf_pady_dim]interior.north~west)~rectangle~
                    ([xshift=-\dim_use:N \l__pf_padx_dim, yshift=\dim_use:N \l__pf_pady_dim]interior.south~east)~
                  }
              }
            \__pf_add_ranges:n {##1}
            \use:x
              {
                \exp_not:N \only < \int_eval:n { \l__pf_from_int + \l__pf_step_int } | handout:0 >
                  { \exp_not:N \fill [#1] ~ \exp_not:V \l__pf_path_tl ; }
              }
          }
        \int_incr:N \l__pf_step_int
      }
  }

% marks={1/3, 6-7/4/state, 1+3+10/5}, lines/step/tone: a disc numbered 1, 2... in order, at the end of each
% line (centered on a range), from its step on; tone as a card's, info (blue) if left out. Several places
% joined by + repeat one number, for a note about several lines, and steps joined by + give each its own
% (1+3+10/5+6+7; the last one for the places left); a disc on a place taken already goes to the left of
% the one there; ranges keep the column, and a disc that would touch one of them, or its bar, moves left
% of it, so none covers another. In print, where every step shows at once and no line is highlighted, a range also gets a
% bar in its tone left of its discs, from its first line to its last
\newcommand\pf@marksidegap{0.25} % between two discs on one line, em of the text beside them
\newcommand\pf@markbar{0.25} % the bar by a range's lines, em of the code
\newcommand\pf@markbargap{0.55} % that bar to the discs, em of the code
\newcommand\pf@markbarinset{0.15} % its ends, inside the first and last lines, a line's height
\tl_new:N \l__pf_tone_tl
\tl_new:N \l__pf_markstep_tl
\tl_new:N \l__pf_place_tl
\int_new:N \l__pf_taken_int
\int_new:N \l__pf_count_int
\prop_new:N \l__pf_taken_prop
\prop_new:N \l__pf_count_prop
\prop_new:N \l__pf_base_prop % where a place's discs start, from the right, em of the code
\prop_new:N \l__pf_used_prop % how much of each line the discs and bars take, from the right, em of the code
\fp_new:N \l__pf_base_fp
\fp_new:N \l__pf_width_fp
\fp_new:N \l__pf_next_fp
\bool_new:N \l__pf_clash_bool
\bool_new:N \l__pf_ranged_bool
\prop_new:N \l__pf_ranged_prop
\prop_new:N \l__pf_bar_prop
% Whether #2 wide at #1 (from the right) touches, closer than #5, anything taken on lines #3 to #4; if so,
% \l__pf_next_fp is the first place left of all it touches
\cs_new_protected:Npn \__pf_mark_clash:nnnnn #1#2#3#4#5
  {
    \bool_set_false:N \l__pf_clash_bool
    \fp_set:Nn \l__pf_next_fp {#1}
    \int_step_inline:nnn {#3} {#4}
      {
        \prop_get:NnNT \l__pf_used_prop {##1} \l_tmpb_tl
          {
            \clist_map_inline:Nn \l_tmpb_tl
              {
                \__pf_mark_interval:w ####1 \q_stop
                \fp_compare:nT { #1 < \l__pf_to_fp + #5 && #1 + #2 + #5 > \l__pf_from_fp }
                  {
                    \bool_set_true:N \l__pf_clash_bool
                    \fp_set:Nn \l__pf_next_fp { max ( \l__pf_next_fp , \l__pf_to_fp + #5 ) }
                  }
              }
          }
      }
  }
\fp_new:N \l__pf_from_fp
\fp_new:N \l__pf_to_fp
\cs_new_protected:Npn \__pf_mark_interval:w #1 ; #2 \q_stop
  { \fp_set:Nn \l__pf_from_fp {#1} \fp_set:Nn \l__pf_to_fp {#2} }
% Takes #1 to #2 (from the right) on lines #3 to #4
\cs_new_protected:Npn \__pf_mark_take:nnnn #1#2#3#4
  {
    \int_step_inline:nnn {#3} {#4}
      {
        \prop_get:NnNF \l__pf_used_prop {##1} \l_tmpb_tl { \tl_clear:N \l_tmpb_tl }
        \tl_if_empty:NF \l_tmpb_tl { \tl_put_right:Nn \l_tmpb_tl { , } }
        \tl_put_right:Nx \l_tmpb_tl { #1 ; #2 }
        \prop_put:NnV \l__pf_used_prop {##1} \l_tmpb_tl
      }
  }
\seq_new:N \l__pf_places_seq
\seq_new:N \l__pf_marksteps_seq
\int_new:N \l__pf_place_int
\cs_generate_variant:Nn \prop_put:Nnn { NVx , NnV , NVn }
\cs_generate_variant:Nn \seq_set_split:Nnn { Nnx }
\prg_generate_conditional_variant:Nnn \prop_get:NnN { NV } { TF }
\prg_generate_conditional_variant:Nnn \prop_if_in:Nn { NV } { p }
\cs_generate_variant:Nn \prop_get:NnN { NVN }
% A place's first and last lines, and its key: its middle, where its discs go
\cs_new_protected:Npn \__pf_mark_place:n #1
  {
    \seq_set_split:Nnn \l_tmpa_seq { - } {#1}
    \tl_set:Nx \l__pf_first_tl { \seq_item:Nn \l_tmpa_seq { 1 } }
    \tl_set:Nx \l__pf_last_tl { \seq_item:Nn \l_tmpa_seq { -1 } }
    \tl_set:Nx \l__pf_place_tl { \fp_eval:n { ( \l__pf_first_tl + \l__pf_last_tl ) / 2 } }
  }
% How many discs a place holds, in prop #1, into int #2
\cs_new_protected:Npn \__pf_mark_get:NN #1#2
  {
    \prop_get:NVNTF #1 \l__pf_place_tl \l_tmpa_tl
      { \int_set:Nn #2 { \l_tmpa_tl } } { \int_zero:N #2 }
  }
\cs_new_protected:Npn \__pf_count_mark:n #1
  {
    \__pf_mark_place:n {#1}
    \__pf_mark_get:NN \l__pf_count_prop \l__pf_count_int
    \prop_put:NVx \l__pf_count_prop \l__pf_place_tl { \int_eval:n { \l__pf_count_int + 1 } }
  }
% Whether the discs of a place share it with a range (their middle the same), so a bar goes left of them all
\cs_new_protected:Npn \__pf_range_mark:n #1
  {
    \__pf_mark_place:n {#1}
    \int_compare:nNnT { \l__pf_first_tl } < { \l__pf_last_tl }
      { \prop_put:NVn \l__pf_ranged_prop \l__pf_place_tl { 1 } }
  }
% Lays out a place's discs, all of them at once, as far right as they go without touching what is laid out
% already on the lines they cover (two for the middle of an even range); a range also takes its bar, left
% of them, on all its lines. Ranges first (\l__pf_ranged_bool), so they keep the column, then the rest
\cs_new_protected:Npn \__pf_layout_mark:n #1
  {
    \__pf_mark_place:n {#1}
    \bool_if:nT
      {
        ! \prop_if_in_p:NV \l__pf_base_prop \l__pf_place_tl
        && ! \bool_xor_p:nn { \l__pf_ranged_bool } { \prop_if_in_p:NV \l__pf_ranged_prop \l__pf_place_tl }
      }
      {
        \__pf_mark_get:NN \l__pf_count_prop \l__pf_count_int
        \fp_set:Nn \l__pf_width_fp { \l__pf_count_int * \pf@markdisc + ( \l__pf_count_int - 1 ) * \pf@marksidegap }
        \fp_zero:N \l__pf_base_fp
        \bool_set_true:N \l__pf_clash_bool
        \bool_while_do:Nn \l__pf_clash_bool
          {
            \__pf_mark_clash:nnnnn { \fp_use:N \l__pf_base_fp } { \fp_use:N \l__pf_width_fp }
              { \int_div_truncate:nn { \l__pf_first_tl + \l__pf_last_tl } { 2 } }
              { \int_div_truncate:nn { \l__pf_first_tl + \l__pf_last_tl + 1 } { 2 } } { \pf@marksidegap }
            \bool_if:NT \l__pf_clash_bool { \fp_set_eq:NN \l__pf_base_fp \l__pf_next_fp }
          }
        \prop_put:NVx \l__pf_base_prop \l__pf_place_tl { \fp_use:N \l__pf_base_fp }
        \__pf_mark_take:nnnn { \fp_use:N \l__pf_base_fp } { \fp_eval:n { \l__pf_base_fp + \l__pf_width_fp } }
          { \int_div_truncate:nn { \l__pf_first_tl + \l__pf_last_tl } { 2 } }
          { \int_div_truncate:nn { \l__pf_first_tl + \l__pf_last_tl + 1 } { 2 } }
      }
    % The bar of a range, once its place is laid out: left of its discs, with the gap a bar keeps from discs;
    % in class, with no bar, nothing
    \bool_if:nT
      {
        \bool_if_p:N \l__pf_ranged_bool && \int_compare_p:nNn { \l__pf_first_tl } < { \l__pf_last_tl }
        && ! \prop_if_in_p:NV \l__pf_bar_prop \l__pf_place_tl
      }
      {
        \prop_put:NVn \l__pf_bar_prop \l__pf_place_tl { 1 }
        \prop_get:NVN \l__pf_base_prop \l__pf_place_tl \l_tmpa_tl
        \__pf_mark_get:NN \l__pf_count_prop \l__pf_count_int
        \fp_set:Nn \l__pf_width_fp { \l_tmpa_tl + \l__pf_count_int * \pf@markdisc + ( \l__pf_count_int - 1 ) * \pf@marksidegap }
        \mode<handout>
          { % only in print, the one place it is drawn
            \__pf_mark_take:nnnn { \fp_eval:n { \l__pf_width_fp + \pf@markbargap } }
              { \fp_eval:n { \l__pf_width_fp + 2 * \pf@markbargap + \pf@markbar - \pf@marksidegap } }
              { \l__pf_first_tl } { \l__pf_last_tl }
          }
      }
  }
\cs_new_protected:Npn \__pf_draw_mark:n #1
  {
    \int_incr:N \l__pf_place_int
    \tl_set:Nx \l__pf_markstep_tl
      { \seq_item:Nn \l__pf_marksteps_seq
        { \int_min:nn { \l__pf_place_int } { \seq_count:N \l__pf_marksteps_seq } } }
    \__pf_mark_place:n {#1}
    % How many discs this place holds already: this one goes to their left
    \__pf_mark_get:NN \l__pf_taken_prop \l__pf_taken_int
    \__pf_mark_get:NN \l__pf_count_prop \l__pf_count_int
    \prop_put:NVx \l__pf_taken_prop \l__pf_place_tl { \int_eval:n { \l__pf_taken_int + 1 } }
    % Where the discs of its place start, laid out before any is drawn
    \prop_get:NVN \l__pf_base_prop \l__pf_place_tl \l_tmpa_tl
    \fp_set:Nn \l__pf_base_fp { \l_tmpa_tl }
    \bool_set:Nn \l__pf_clash_bool
      { \int_compare_p:nNn { \l__pf_first_tl } < { \l__pf_last_tl } && ! \prop_if_in_p:NV \l__pf_bar_prop \l__pf_place_tl }
    \use:x
      {
        % The bar, once per place, left of all its discs
        \bool_lazy_and:nnT
          { \int_compare_p:nNn { \l__pf_first_tl } < { \l__pf_last_tl } }
          { ! \prop_if_in_p:NV \l__pf_bar_prop \l__pf_place_tl }
          {
            \exp_not:N \mode < handout >
              {
                \exp_not:N \draw [ tone@\l__pf_tone_tl , line~cap = round ,
                    line~width = \fp_to_dim:n { \pf@markbar * \pf@codesizenow * \pf@em } ] ~
                  ( [ xshift = - \fp_to_dim:n { \l__pf_padx_dim + ( \l__pf_base_fp + \l__pf_count_int * \pf@markdisc
                        + ( \l__pf_count_int - 1 ) * \pf@marksidegap + \pf@markbargap + \pf@markbar / 2 )
                        * \pf@codesizenow * \pf@em } ,
                      yshift = - \fp_to_dim:n { \l__pf_pady_dim + ( \l__pf_first_tl - 1 + \pf@markbarinset ) * \l__pf_line_dim } ]
                    interior.north~east ) ~ -- ~ ++ ( 0 ,
                    - \fp_to_dim:n { ( \l__pf_last_tl - \l__pf_first_tl + 1 - 2 * \pf@markbarinset ) * \l__pf_line_dim } ) ;
              }
          }
        \exp_not:N \only < \l__pf_markstep_tl - >
          {
            \exp_not:N \node [ pf~mark = \pf@codesizenow , fill = tone@\l__pf_tone_tl , anchor = east ] ~ at ~
              ( [ xshift = - \fp_to_dim:n { \l__pf_padx_dim + ( \l__pf_base_fp + \l__pf_taken_int
                    * ( \pf@markdisc + \pf@marksidegap ) ) * \pf@codesizenow * \pf@em } ,
                  yshift = - \fp_to_dim:n { \l__pf_pady_dim + ( \l__pf_first_tl + \l__pf_last_tl - 1 ) / 2 * \l__pf_line_dim } ]
                interior.north~east ) { \int_use:N \l__pf_mark_int } ;
          }
      }
    \bool_if:NT \l__pf_clash_bool { \prop_put:NVn \l__pf_bar_prop \l__pf_place_tl { 1 } }
  }
% Each mark's number, steps and tone, then \__pf_..._mark:n on each of its places
\cs_new_protected:Npn \__pf_map_marks:N #1
  {
    \int_set:Nn \l__pf_mark_int { \l__pf_markfrom_int - 1 }
    \clist_map_inline:Nn \l__pf_marks_clist
      {
        \int_incr:N \l__pf_mark_int
        \seq_set_split:Nnn \l_tmpb_seq { / } {##1}
        % A fourth field numbers it, and the next ones go on from there: a block showing only some notes
        \int_compare:nNnT { \seq_count:N \l_tmpb_seq } > { 3 }
          { \int_set:Nn \l__pf_mark_int { \seq_item:Nn \l_tmpb_seq { 4 } } }
        \seq_set_split:Nnx \l__pf_marksteps_seq { + } { \seq_item:Nn \l_tmpb_seq { 2 } }
        \int_zero:N \l__pf_place_int
        \tl_set:Nx \l__pf_tone_tl
          { \int_compare:nNnTF { \seq_count:N \l_tmpb_seq } > { 2 } { \seq_item:Nn \l_tmpb_seq { 3 } } { info } }
        \seq_set_split:Nnx \l__pf_places_seq { + } { \seq_item:Nn \l_tmpb_seq { 1 } }
        \seq_map_function:NN \l__pf_places_seq #1
      }
  }
% First how many discs each place holds, so a bar can go left of them all; then the discs
\cs_new_protected:Npn \__pf_draw_marks:
  {
    \prop_clear:N \l__pf_count_prop
    \prop_clear:N \l__pf_taken_prop
    \prop_clear:N \l__pf_base_prop
    \prop_clear:N \l__pf_used_prop
    \prop_clear:N \l__pf_ranged_prop
    \prop_clear:N \l__pf_bar_prop
    \__pf_map_marks:N \__pf_count_mark:n
    \__pf_map_marks:N \__pf_range_mark:n
    \bool_set_true:N \l__pf_ranged_bool
    \__pf_map_marks:N \__pf_layout_mark:n
    \bool_set_false:N \l__pf_ranged_bool
    \__pf_map_marks:N \__pf_layout_mark:n
    \prop_clear:N \l__pf_bar_prop
    \__pf_map_marks:N \__pf_draw_mark:n
  }
\NewDocumentCommand \pfcodemarks { } { \__pf_draw_marks: }

% lines={1|2|3}: the code written line by line, one step each from steps from: on each, the lines after
% the given one are hidden, so the class can be asked for the next; after the last, all show
% (covered in the block's own background, tcbcolback, so a console's red tint shows no patch)
\cs_new_protected:Npn \__pf_draw_lines:
  {
    \int_zero:N \l__pf_step_int
    \seq_map_inline:Nn \l__pf_lines_seq
      {
        \tl_if_blank:nF {##1} { \use:x
          {
            \exp_not:N \only < \int_eval:n { \l__pf_from_int + \l__pf_step_int } | handout:0 >
              {
                \exp_not:N \fill [ tcbcolback ] ~
                  ( [ xshift = \dim_use:N \l__pf_padx_dim ,
                      yshift = \dim_eval:n { - \l__pf_pady_dim - \l__pf_line_dim * ##1 } ] interior.north~west ) ~ rectangle ~
                  ( [ xshift = - \dim_use:N \l__pf_padx_dim ] interior.south~east ) ;
              }
          } }
        \int_incr:N \l__pf_step_int
      }
  }
\NewDocumentCommand \pfcodelines { } { \__pf_draw_lines: }

% strike={14/3}, line/step: a line that does not compile, written as any other and crossed out from the
% step on, for the error note that points at it, by a line in the tone of errors from its first character
% to its last. The listing's file gives the line's text: in a monospaced font, its columns give the ends
\newcommand\pf@strikeraise{0} % the line through the text, from the middle of its row, em of the code: halfway up the small letters, most of any code
\newcommand\pf@strikethickness{0.1} % em of the code
\newcommand\pf@codelistingfile{\jobname.listing}
\ior_new:N \g__pf_code_ior
\str_new:N \l__pf_codeline_str
\dim_new:N \l__pf_codeleft_dim
\cs_new_protected:Npn \__pf_draw_strike:n #1
  {
    \seq_set_split:Nnn \l_tmpb_seq { / } {#1}
    \tl_set:Nx \l__pf_first_tl { \seq_item:Nn \l_tmpb_seq { 1 } }
    \ior_open:Nn \g__pf_code_ior { \pf@codelistingfile }
    \prg_replicate:nn { \l__pf_first_tl } { \ior_str_get:NN \g__pf_code_ior \l__pf_codeline_str }
    \ior_close:N \g__pf_code_ior
    \str_set_eq:NN \l_tmpa_str \l__pf_codeline_str
    \tl_trim_spaces:N \l_tmpa_str
    \tl_set:Nx \l_tmpb_tl
      {
        \exp_not:N \only < \seq_item:Nn \l_tmpb_seq { 2 } - >
          {
            \exp_not:N \draw [ tone@error , line~width = \fp_to_dim:n { \pf@strikethickness * \l__pf_size_dim } ] ~
              ( [ xshift = \dim_eval:n { \l__pf_codeleft_dim + \l__pf_char_dim
                    * ( \str_count:N \l__pf_codeline_str - \str_count:N \l_tmpa_str ) } ,
                  yshift = \fp_to_dim:n { - \l__pf_pady_dim - ( \__pf_row:n { \l__pf_first_tl } - 0.5 ) * \l__pf_line_dim
                    + \pf@strikeraise * \l__pf_size_dim } ]
                interior.north~west ) ~ -- ~ ++ ( \dim_eval:n { \l__pf_char_dim * \str_count:N \l_tmpa_str } , 0 ) ;
          }
      }
    \tl_use:N \l_tmpb_tl
  }
\cs_new_protected:Npn \__pf_draw_strikes:
  {
    \clist_if_empty:NF \l__pf_strikes_clist
      {
        \dim_set:Nn \l__pf_codeleft_dim
          { \l__pf_padx_dim + \fp_to_dim:n { ( \pf@codenumberwidth + \pf@codenumbergap ) * \l__pf_size_dim } }
        \clist_map_function:NN \l__pf_strikes_clist \__pf_draw_strike:n
      }
  }
\NewDocumentCommand \pfcodestrikes { } { \__pf_draw_strikes: }
\NewDocumentCommand \pfcodesetup { m } { \pf_code_setup:n {#1} }

% add={9/4}, line/step: a line added on that step. Each step is typeset on its own, so on the ones before
% it the block leaves it out and numbers the rest in order, and every line the block refers to (steps,
% marks, strike) moves to the row it takes on that step; print shows every line
\seq_new:N \l__pf_hidden_seq
\int_new:N \l__pf_now_int
\int_new:N \l__pf_hidemax_int
\int_new:N \l__pf_hidecount_int
\prop_new:N \l__pf_rows_prop
\tl_new:N \l__pf_range_tl
% The row line #1 takes on this step
\cs_new:Npn \__pf_row:n #1
  {
    \int_compare:nNnTF {#1} > { \l__pf_hidemax_int }
      { \int_eval:n { #1 - \l__pf_hidecount_int } } { \prop_item:Nn \l__pf_rows_prop {#1} }
  }
\cs_new_protected:Npn \__pf_to_rows:N #1
  { \regex_replace_all:nnN { [0-9]+ } { \c{__pf_row:n} \cB\{ \0 \cE\} } #1 \tl_set:Nx #1 {#1} }
\cs_new_protected:Npn \pf_code_hide:
  {
    \seq_clear:N \l__pf_hidden_seq
    \int_zero:N \l__pf_hidemax_int
    \int_set:Nn \l__pf_now_int { \beamer@slideinframe }
    \mode<handout>{ \int_set_eq:NN \l__pf_now_int \c_max_int }
    \clist_map_inline:Nn \l__pf_adds_clist
      {
        \seq_set_split:Nnn \l_tmpa_seq { / } {##1}
        \int_compare:nNnT { \seq_item:Nn \l_tmpa_seq { 2 } } > { \l__pf_now_int }
          { \seq_put_right:Nx \l__pf_hidden_seq { \seq_item:Nn \l_tmpa_seq { 1 } } }
      }
    \int_set:Nn \l__pf_hidecount_int { \seq_count:N \l__pf_hidden_seq }
    \seq_if_empty:NF \l__pf_hidden_seq
      {
        \seq_sort:Nn \l__pf_hidden_seq
          { \int_compare:nNnTF {##1} > {##2} { \sort_return_swapped: } { \sort_return_same: } }
        \int_set:Nn \l__pf_hidemax_int { \seq_item:Nn \l__pf_hidden_seq { -1 } }
        % Each line up to the last one left out, and its row
        \prop_clear:N \l__pf_rows_prop
        \int_zero:N \l_tmpa_int
        \int_step_inline:nn { \l__pf_hidemax_int }
          {
            \prop_put:Nnx \l__pf_rows_prop {##1} { \int_eval:n { ##1 - \l_tmpa_int } }
            \seq_if_in:NnT \l__pf_hidden_seq {##1} { \int_incr:N \l_tmpa_int }
          }
        % The lines the listing keeps: the ranges between those left out, the last one to the end
        \tl_clear:N \l__pf_range_tl
        \int_set:Nn \l_tmpb_int { 1 }
        \seq_map_inline:Nn \l__pf_hidden_seq
          {
            \int_compare:nNnT {##1} > { \l_tmpb_int }
              { \tl_put_right:Nx \l__pf_range_tl { \int_use:N \l_tmpb_int - \int_eval:n { ##1 - 1 } , } }
            \int_set:Nn \l_tmpb_int { ##1 + 1 }
          }
        \tl_put_right:Nx \l__pf_range_tl { \int_use:N \l_tmpb_int - \int_use:N \c_max_int }
        % After the listing options of the block, which pf code finish follows
        \tcbset { listing~options/.expanded = { \exp_not:o { \kvtcb@listingoptions } , linerange = { \l__pf_range_tl } } }
        % The steps and the marks' places, in rows
        \seq_clear:N \l_tmpb_seq
        \seq_map_inline:Nn \l__pf_steps_seq
          {
            \tl_set:Nn \l_tmpa_tl {##1}
            \__pf_to_rows:N \l_tmpa_tl
            \seq_put_right:NV \l_tmpb_seq \l_tmpa_tl
          }
        \seq_set_eq:NN \l__pf_steps_seq \l_tmpb_seq
        \tl_clear:N \l_tmpb_tl
        \clist_map_inline:Nn \l__pf_marks_clist
          {
            \seq_set_split:Nnn \l_tmpa_seq { / } {##1}
            \seq_pop_left:NN \l_tmpa_seq \l_tmpa_tl
            \__pf_to_rows:N \l_tmpa_tl
            \tl_put_right:Nx \l_tmpb_tl { \l_tmpa_tl / \seq_use:Nn \l_tmpa_seq { / } , }
          }
        \clist_set:NV \l__pf_marks_clist \l_tmpb_tl
      }
  }
\NewDocumentCommand \pfcodehide { } { \pf_code_hide: }
\NewDocumentCommand \pfcodebands { } { \__pf_draw_steps:nn { colorCodeCurrentLine } { \c_false_bool } }
\NewDocumentCommand \pfcodedim { }
  {
    \bool_if:NT \l__pf_dim_bool
      { \__pf_draw_steps:nn { colorCodeBg, opacity=\pf@codedim, even~odd~rule } { \c_true_bool } }
  }
\ExplSyntaxOff

% The frame every code block and terminal shares: a rounded hairline in #1, neutral but for errors
\tcbset{
  pf code size/.store in=\pf@codesizenow,
  pf code size=\pf@codesize,
  compact/.style={pf code size=\pf@codecompactsize},
  dense/.style={pf code size=\pf@codedensesize},
  packed/.style={pf code size=\pf@codetightsize},
  pf code box/.style={
    enhanced, listing only, arc=\pf@radius, boxsep=0pt,
    colback=colorCodeBg, colframe=#1, boxrule=\pf@hairline,
    before skip=0pt, after skip=0pt,
    steps={}, steps from=1, dim=true, marks={}, marks from=1, lines={}, strike={}, add={}},
  % After the block's own options, so compact and dense are known
  pf code finish/.style={
    code={\pfcodesetup{\pf@codesizenow}\pfcodehide},
    left=\slideem{\pf@codepaddingx*\pf@codesizenow}, right=\slideem{\pf@codepaddingx*\pf@codesizenow},
    top=\slideem{\pf@codepaddingy*\pf@codesizenow}, bottom=\slideem{\pf@codepaddingy*\pf@codesizenow},
    underlay={\pfcodebands}, finish={\pfcodedim\pfcodelines\pfcodestrikes\pfcodemarks}}, % finish, unlike overlay, draws over the text
  % C and Java side by side: every line readable, only the differences highlighted
  diff/.style={dim=false}}

% \begin{codeblock}[steps={1,5|2,4|3}, steps from=2, compact]{java}; the language is java or c;
% marks={1/3, 2/4} numbers lines for the notes of codenotes, from 1 or from marks from (a block whose notes
% go on from another's); lines={1|2|3} writes it line by line; strike={9/4} crosses out a line that does not
% compile; add={9/4} adds a line on a step
\DeclareTCBListing{codeblock}{ O{} m }{%
  pf code box=colorCodeEdge, #1, listing options={style=pf code, language=pf#2}, pf code finish}

% \begin{console} what a program prints, with no line numbers; consoleerror tints it red
\DeclareTCBListing{console}{ O{} }{%
  pf code box=colorCodeEdge, #1, pf code finish,
  listing options={style=pf base}}
\DeclareTCBListing{consoleerror}{ O{} }{%
  pf code box=paletteRed!\pf@codeedgetint!colorBg, colback=paletteRed!\pf@ruletint!colorCodeBg, #1, pf code finish,
  listing options={style=pf base}}

% Code in running text (\code in commands.tex): the code font on a rounded tint, in the color of the
% text around it. The tint has a fixed height, in em of the text, whatever the code holds
\newcommand\pf@inlineheight{0.78} % over the baseline, em of the text
\newcommand\pf@inlinedepth{0.24} % under the baseline
\newcommand\pf@inlinepaddingx{0.18} % around the code, em of the text
\newcommand\pf@inlinepaddingy{0.06}
\newcommand\inlinecode[1]{%
  \tikz[baseline=(pf@inline.base)]\node[fill=colorCodeInline, rounded corners=\pf@smallradius,
    inner xsep=\pf@inlinepaddingx em, inner ysep=\pf@inlinepaddingy em,
    text height=\pf@inlineheight em, text depth=\pf@inlinedepth em] (pf@inline) {\texttt{#1}};}

% \codeunused<step>{name}: \code that, from the step, dims and is crossed out, as the starred words of the keyword
% grid, for the names a table lists but the course leaves aside (e.g. "Java's exceptions")
\newcommand\pf@codeunusedraise{0.3} % the line through it, over the baseline, em of the text
\NewDocumentCommand\codeunused{ D<>{1-} m }{%
  \tikz[baseline=(pf@inline.base)]{%
    \begin{scope}[transparency group, alt={<#1>{opacity=\pf@keywordunused}{}}]
      \node[fill=colorCodeInline, rounded corners=\pf@smallradius,
        inner xsep=\pf@inlinepaddingx em, inner ysep=\pf@inlinepaddingy em,
        text height=\pf@inlineheight em, text depth=\pf@inlinedepth em] (pf@inline) {\texttt{#2}};
      \draw[paletteRed, line width=\pf@hairline, visible on=<#1>]
        ([xshift=\pf@inlinepaddingx em, yshift=\pf@codeunusedraise em]pf@inline.base west) --
        ([xshift=-\pf@inlinepaddingx em, yshift=\pf@codeunusedraise em]pf@inline.base east);
    \end{scope}}}

% A file or column name over a block of code; always as tall as a line with code in it, so blocks side
% by side line up whether their titles hold \code or not
\newcommand\blocktitle[1]{%
  {\slidefont{\pf@blocktitlesize}{1.2}\bfseries\color{colorHeading}\vphantom{\inlinecode{X}}#1\par}%
  \vskip\slideem{\pf@blocktitlegap}}

% % % % % % % % % % TikZ on a step % % % % % % % % % %
% visible on=<2->: the node or path keeps its place and shows from that step on
\tikzset{
  alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
  visible on/.style={alt={#1{}{opacity=0}}},
  dim on/.code args={<#1>}{\alt<#1| handout:0>{\pgfkeysalso{opacity=\pf@stepdim}}{}}} % dim on=<4->: faded from that step on, but not in print
\newcommand\pf@stepdim{0.25} % what is left of something faded on a step

% % % % % % % % % % Flow diagram % % % % % % % % % %
% Five columns across the slide: boxes in columns 1, 3 and 5, arrows between them, an arrow over the
% row from end to end (the IDE's Run button), and a dashed branch from the middle box down to a
% lower row. Every command takes a step and TikZ options, e.g. \flowbox<2->[dim on=<4->]. See the
% first slides of unit 1.
\newcommand\pf@flowboxsize{0.7}
\newcommand\pf@flowdetailsize{0.525} % the second line of a box, 0.75 em of the box text
\newcommand\pf@flowboxheight{2.5} % em of the slide, so boxes of one or two lines match
\newcommand\pf@flowboxtint{10} % box background, percent of its tone
\newcommand\pf@flowlabelsize{0.5}
\newcommand\pf@flowlabelgap{0.3} % an arrow to the text over and under it
\newcommand\pf@flowhead{0.35} % arrowhead, em of the slide
\newcommand\pf@flowdrop{3.4} % between the main row and the branch: room for a console under a box
\newcommand\pf@flowcaptiongap{0.3}
\newcommand\pf@flowoverheight{1.1} % how far the arrow over the row rises above the boxes, em of the slide
\newdimen\pf@flowcol
\newdimen\pf@flowheadlength % arrow tips take a plain length, not an expression
\pf@flowheadlength=\slideem{\pf@flowhead}

\colorlet{tone@source}{colorHeading}
\colorlet{tone@output}{colorMuted} % whatever the compiler generates: neutral, as orange means take care
\colorlet{tone@ok}{colorAccentTwo}

\tikzset{
  flow box/.style={draw=tone@#1, fill=tone@#1!\pf@flowboxtint!colorBg, line width=\pf@hairline,
    rounded corners=\pf@radius,
    minimum width=\pf@flowcol-\pf@hairline, minimum height=\slideem{\pf@flowboxheight}, inner sep=0pt, % the line inside the column
    align=center, text=colorText, font=\slidefont{\pf@flowboxsize}{1.3}},
  flow arrow/.style={draw=colorText, line width=\pf@arrowline, line cap=round,
    -{Latex[round, length=\the\pf@flowheadlength, width=\the\pf@flowheadlength]}},
  flow label/.style={inner sep=0pt, text=colorText, align=center,
    font=\slidefont{\pf@flowlabelsize}{1.25}\pf@nohyphens}, % whole words, as on the web
  flow command/.style={inner sep=0pt, text=colorText, font=\slidefont{\pf@flowlabelsize}{1.25}\ttfamily}}

% \begin{flow} ... \end{flow}: one row of boxes, with an optional branch under it
\NewDocumentEnvironment{flow}{}
  {\par\noindent\pf@flowcol=\dimexpr\linewidth/5\relax\begin{tikzpicture}}
  {\end{tikzpicture}\par}

% \flowbox<step>{name}{column}{row}{tone}{Title}{second line}: row 0 is the main row, 1 the branch;
% tone is source, output, ok or error
\NewDocumentCommand\flowbox{ D<>{1-} O{} m m m m m m }{%
  % A transparency group, so whatever a box holds hides and fades with it
  \begin{scope}[transparency group, visible on=<#1>, #2]
    \node[flow box=#6] (#3)
      at ({(#4-0.5)*\pf@flowcol}, {-#5*\slideem{\pf@flowboxheight+\pf@flowdrop}})
      {{\bfseries #7}\if\relax\detokenize{#8}\relax\else
        \\[\slideem{0.2*\pf@flowboxsize}]{\slidefont{\pf@flowdetailsize}{1.3}#8}\fi};
  \end{scope}}

% \flowarrow<step>[options]{from}{to}{label over it}{command under it}
\NewDocumentCommand\flowarrow{ D<>{1-} O{} m m m m }{%
  \begin{scope}[transparency group, visible on=<#1>, #2] % faded as one, or line and tip overlap
    \draw[flow arrow] (#3.east) -- (#4.west)
      node[midway, above=\slideem{\pf@flowlabelgap}, flow label] {#5}
      node[midway, below=\slideem{\pf@flowlabelgap}, flow command] {#6};
  \end{scope}}

% \flowover<step>[options]{from}{to}{label}: over the row, straight up from one box, across and down
% into another, its label over the middle
\NewDocumentCommand\flowover{ D<>{1-} O{} m m m }{%
  \begin{scope}[transparency group, visible on=<#1>, #2] % faded as one, or line and tip overlap
    \draw[flow arrow] (#3.north) -- ++(0,\slideem{\pf@flowoverheight})
      -| node[pos=0.25, above=\slideem{\pf@flowlabelgap}, flow label] {#5} (#4.north);
  \end{scope}}

% \flowbranch<step>[options]{from}{to}{label}{command}: dashed, down from a box and on to one in the branch row
\NewDocumentCommand\flowbranch{ D<>{1-} O{} m m m m }{%
  \begin{scope}[transparency group, visible on=<#1>, #2] % faded as one, or line and tip overlap
    \draw[flow arrow, dashed] (#3.south) |- (#4.west)
      node[pos=0.75, above=\slideem{\pf@flowlabelgap}, flow label] {#5}
      node[pos=0.75, below=\slideem{\pf@flowlabelgap}, flow command] {#6};
  \end{scope}}

% \flowcaption<step>[options]{box}{text}: a short description under a box
\NewDocumentCommand\flowcaption{ D<>{1-} O{} m m }{%
  \node[flow label, anchor=north, text width=\pf@flowcol, visible on=<#1>, #2]
    at ([yshift=-\slideem{\pf@flowcaptiongap}]#3.south) {#4};}

% \flowconsole<step>[tone]{box}{lines}: what a box holds or prints, under it and as wide, drawn as a
% console block; lines split by \; error tints it as consoleerror. Named <box>console, so a branch
% or a caption can start from it
\newcommand\pf@flowconsolegap{0.5} % the box to its console, em of the slide
\NewDocumentCommand\flowconsole{ D<>{1-} O{plain} m m }{%
  \def\pf@tone{#2}\def\pf@error{error}%
  \ifx\pf@tone\pf@error
    \tikzset{pf console tone/.style={draw=paletteRed!\pf@codeedgetint!colorBg, fill=paletteRed!\pf@ruletint!colorCodeBg}}%
  \else
    \tikzset{pf console tone/.style={draw=colorCodeEdge, fill=colorCodeBg}}%
  \fi
  \begin{scope}[visible on=<#1>]
    \node[anchor=north, rounded corners=\pf@radius, line width=\pf@hairline, pf console tone,
      text width=\dimexpr\pf@flowcol-2\pf@hairline-2\slideem{\pf@codepaddingx*\pf@codesnippetsize}\relax, % as wide as its box
      inner xsep=\slideem{\pf@codepaddingx*\pf@codesnippetsize}, inner ysep=\slideem{\pf@codepaddingy*\pf@codesnippetsize}, % as a code block
      align=left, text=colorText, font=\slidefont{\pf@codesnippetsize}{\pf@codelineheight}\ttfamily]
      (#3console) at ([yshift=-\slideem{\pf@flowconsolegap}]#3.south) {#4};
  \end{scope}}

% A small code block under a box, as wide as the box, in the free part of the branch row: build it in
% \begin{lrbox}{\flowsnippetbox} \begin{codeblock}[snippet]{c} ... \end{codeblock} \end{lrbox},
% then \flowsnippet<step>{box} sets it under that box
\newsavebox\flowsnippetbox
\newcommand\pf@snippetgap{0.5} % the box to the code under it, em of the slide
\tcbset{snippet/.style={pf code size=\pf@codesnippetsize, width=\dimexpr\linewidth/5-\pf@hairline\relax}} % one box
\NewDocumentCommand\flowsnippet{ D<>{1-} m }{%
  \begin{scope}[transparency group, visible on=<#1>]
    \node[anchor=north west, inner sep=0pt] at ([yshift=-\slideem{\pf@snippetgap}]#2.south west)
      {\usebox\flowsnippetbox};
  \end{scope}}

% The Run button of an IDE, for an arrow's label
\newcommand\runicon{\tikz[baseline=-0.1em]\fill[colorAccentTwo] (0,-0.5em) -- (0,0.5em) -- (0.85em,0) -- cycle;}

% % % % % % % % % % Toolbox % % % % % % % % % %
% \begin{toolbox}{Java Development Kit}{JDK}[what it is for]: a frame holding groups of tools,
% \toolgroup in columns, or a nested \begin{runtime} block with its parts
\newcommand\pf@toolboxpadding{0.6}
\newcommand\pf@toolboxgap{0.45}
\newcommand\pf@toolboxtint{6}
\newcommand\pf@toolboxbandtint{14} % the nested block, a step darker
\newcommand\pf@toolboxlabelsize{0.7}
\newcommand\pf@toolboxabbrsize{0.56} % 0.8 em of the label
\newcommand\pf@toolboxabbrgap{0.15} % the name to its abbreviation, em of the slide
\newcommand\pf@toolboxdescsize{0.55}
\newcommand\pf@toolboxgroupsize{0.45}
\newcommand\pf@toolpadding{0.3}
\newcommand\pf@toolcommandsize{0.65}
\newcommand\pf@tooltextsize{0.45}
\newcommand\pf@toolpartsize{0.55} % the parts of the nested block: fewer words, more room
\colorlet{colorToolEdge}{colorHeading!25!colorBg}

\tcbset{
  pf toolbox/.style={enhanced, arc=\pf@radius, boxsep=0pt, boxrule=\pf@hairline,
    colframe=colorHeading, colback=colorHeading!#1!colorBg,
    left=\slideem{\pf@toolboxpadding}, right=\slideem{\pf@toolboxpadding},
    top=\slideem{\pf@toolboxpadding}, bottom=\slideem{\pf@toolboxpadding},
    before skip=0pt, after skip=0pt},
  pf tool/.style={enhanced, arc=\pf@smallradius, boxsep=0pt, boxrule=\pf@hairline,
    colframe=colorToolEdge, colback=colorBg, left=\slideem{\pf@toolpadding},
    right=\slideem{\pf@toolpadding}, top=\slideem{\pf@toolpadding}, bottom=\slideem{\pf@toolpadding},
    before skip=0pt},
  pf toolgroup/.style={blank, boxsep=0pt, left=0pt, right=0pt, top=0pt, bottom=0pt}}

\newcommand\pf@toolboxhead[3]{%
  {\slidefont{\pf@toolboxlabelsize}{1.2}\heavyseries\color{colorHeading}#1\par
   \vskip\slideem{\pf@toolboxabbrgap}\slidefont{\pf@toolboxabbrsize}{1.2}#2\par}%
  \if\relax\detokenize{#3}\relax\else
    \vskip\slideem{0.3}{\slidefont{\pf@toolboxdescsize}{1.3}\raggedright #3\par}%
  \fi
  \vskip\slideem{\pf@toolboxgap+0.5}}

\NewDocumentEnvironment{toolbox}{ m m O{} }
  {\begin{tcolorbox}[pf toolbox=\pf@toolboxtint]\pf@toolboxhead{#1}{#2}{#3}}
  {\end{tcolorbox}}

% \begin{toolgroups} \toolgroup<2->{Build and run}{\tool{javac}{...}\tool{java}{...}} ... \end{toolgroups}
\NewDocumentEnvironment{toolgroups}{ O{3} }
  {\begin{tcbraster}[raster columns=#1, raster valign=top, raster column skip=\slideem{\pf@toolboxgap},
    raster before skip=0pt, raster after skip=0pt]}
  {\end{tcbraster}}
\NewDocumentCommand\toolgroup{ D<>{1-} m m }{%
  \begin{tcolorbox}[pf toolgroup]
    \begin{uncoverenv}<#1>%
      {\slidefont{\pf@toolboxgroupsize}{1.2}\bfseries\color{colorMuted}#2\par}%
      \vskip\slideem{\pf@toolboxgap}#3%
    \end{uncoverenv}
  \end{tcolorbox}}
% A command: its name as code and what it does
\newcommand\tool[2]{%
  \begin{tcolorbox}[pf tool, after skip=\slideem{\pf@toolboxgap}]
    {\slidefont{\pf@toolcommandsize}{1.2}\ttfamily\color{colorText}#1\par}%
    \vskip\slideem{0.15}{\slidefont{\pf@tooltextsize}{1.3}\raggedright\pf@linegrid#2\par}%
  \end{tcolorbox}}

% \begin{runtime}<2->{Java Runtime Environment}{JRE}{what it is for} \toolpart<3->{JVM}{...} \end{runtime}
\NewDocumentEnvironment{runtime}{ D<>{1-} m m m }
  {\begin{uncoverenv}<#1>\begin{tcolorbox}[pf toolbox=\pf@toolboxbandtint]\pf@toolboxhead{#2}{#3}{#4}%
   \begin{tcbraster}[raster columns=2, raster valign=top, raster column skip=\slideem{\pf@toolboxgap},
     raster before skip=0pt, raster after skip=0pt]}
  {\end{tcbraster}\end{tcolorbox}\end{uncoverenv}}
% A part rather than a command: named in the heading blue, not as code
\NewDocumentCommand\toolpart{ D<>{1-} m m }{%
  \begin{uncoverenv}<#1>%
  \begin{tcolorbox}[pf tool]
    {\slidefont{\pf@toolcommandsize}{1.2}\bfseries\color{colorHeading}#2\par}%
    \vskip\slideem{0.15}{\slidefont{\pf@toolpartsize}{1.3}\raggedright\pf@linegrid#3\par}%
  \end{tcolorbox}%
  \end{uncoverenv}}

% % % % % % % % % % Data table % % % % % % % % % %
% \begin{datatable}{l l X}: hairlines under every row (\tablerule), a heading-blue line under the
% header and after each group (\grouprule); answers on a step go in \uncover, so their lines stay
\newcommand\pf@tablesize{0.52}
\newcommand\pf@tablepaddingx{0.7} % em of the table text
\newcommand\pf@tablestretch{1.65} % row height, so a row has about 0.45 em above and below its text
\newcommand\pf@tabledensesize{0.44} % [dense]: a reference table too long for the slide (e.g. "Java's exceptions")
\newcommand\pf@tabledensestretch{1.45}

% \begin{datatable}[dense]{l Y}: dense, smaller text and rows
\newenvironment{datatable}[2][]
  {\par\noindent
   \def\pf@tableoption{#1}\def\pf@tabledense{dense}%
   \ifx\pf@tableoption\pf@tabledense
     \let\pf@tablesizenow\pf@tabledensesize\let\pf@tablestretchnow\pf@tabledensestretch
   \else
     \let\pf@tablesizenow\pf@tablesize\let\pf@tablestretchnow\pf@tablestretch
   \fi
   \slidefont{\pf@tablesizenow}{1.35}%
   \setlength\tabcolsep{\slideem{\pf@tablepaddingx*\pf@tablesizenow}}%
   \renewcommand\arraystretch{\pf@tablestretchnow}%
   \setlength\aboverulesep{0pt}\setlength\belowrulesep{0pt}% the rows' own height is the padding
   \renewcommand\tabularxcolumn[1]{m{##1}}% X as m, centered as M
   \tabularx{\linewidth}{#2}}
  {\endtabularx\par}
\newcommand\tablerule{\arrayrulecolor{colorCodeEdge}\specialrule{\pf@hairline}{0pt}{0pt}}
\newcommand\grouprule{\arrayrulecolor{colorHeading}\specialrule{\pf@hairline}{0pt}{0pt}}
\newcommand\tablehead[1]{\textbf{\textcolor{colorHeading}{#1}}} % a column's name
\newcommand\tablelabel[1]{\textbf{\textcolor{colorHeading}{#1}}} % a row's feature, in a comparison
% \leavevmode: a cell that starts with \uncover would otherwise sit a line lower; m: every cell centered on
% the row's tallest
\newcolumntype{M}{>{\centering\arraybackslash\leavevmode}m{6.5em}} % a column of marks, as wide as "Convention?"
\newcolumntype{Y}{>{\raggedright\arraybackslash\leavevmode}X} % a column that takes the spare width
\newcolumntype{C}{>{\centering\arraybackslash\leavevmode}X} % marks sharing the spare width, in a table of marks only
% \celllines{first \\ second}: a cell's text on several lines, as close together as in a paragraph,
% e.g. a call too long for its column, broken where Java allows it; centered on the row's other cells,
% with the same padding above and below as a row of one line
\newsavebox\pf@cellbox
\newcommand\celllines[1]{%
  \sbox\pf@cellbox{\renewcommand\arraystretch{1}\begin{tabular}{@{}l@{}}#1\end{tabular}}%
  \rule[-\dimexpr\dp\pf@cellbox+\pf@tablestretchnow\dp\strutbox-\dp\strutbox\relax]{0pt}%
    {\dimexpr\ht\pf@cellbox+\dp\pf@cellbox+(\pf@tablestretchnow\ht\strutbox-\ht\strutbox)%
      +(\pf@tablestretchnow\dp\strutbox-\dp\strutbox)\relax}%
  \usebox\pf@cellbox}
% A line under part of a row, such as the rows a category cell spans: \partrule{2-5}
\newcommand\partrule[1]{\arrayrulecolor{colorCodeEdge}\cmidrule[\pf@hairline]{#1}}

% % % % % % % % % % Keyword grid % % % % % % % % % %
% \keywordgrid<2->{abstract, *assert, boolean}: five columns, in order across the rows; from the step,
% the starred ones dim and are crossed out
\newcommand\pf@keywordcolumns{5}
\newcommand\pf@keywordsize{0.55}
\newcommand\pf@keywordgap{0.2} % em of the words
\newcommand\pf@keywordpaddingy{0.15}
\newcommand\pf@keywordpaddingx{0.5}
\newcommand\pf@keywordtint{6}
\newcommand\pf@keywordunused{0.35}
\newdimen\pf@keywordwidth
\newdimen\pf@keywordtext

\ExplSyntaxOn
\int_new:N \l__pf_keyword_int
\NewDocumentCommand \keywordgrid { D<>{1-} m }
  {
    \par\noindent
    \group_begin:
    \slidefont{\pf@keywordsize}{1.3}
    \dim_set:Nn \pf@keywordwidth
      { ( \linewidth - \slideem{\pf@keywordgap*\pf@keywordsize*(\pf@keywordcolumns-1)} ) / \pf@keywordcolumns - 1pt }
    \int_zero:N \l__pf_keyword_int
    \clist_map_inline:nn {#2}
      {
        \int_compare:nNnT { \int_mod:nn { \l__pf_keyword_int } { \pf@keywordcolumns } } = { 0 }
          {
            \int_compare:nNnT { \l__pf_keyword_int } > { 0 }
              { \par\nointerlineskip\vskip\slideem{\pf@keywordgap*\pf@keywordsize}\noindent }
          }
        \int_compare:nNnF { \int_mod:nn { \l__pf_keyword_int } { \pf@keywordcolumns } } = { 0 }
          { \hfill } % the gap, with the 1 pt each cell gives up against rounding
        \tl_if_head_eq_charcode:nNTF {##1} *
          { \exp_args:Nx \__pf_keyword:nnn { \tl_tail:n {##1} } {#1} { true } }
          { \__pf_keyword:nnn {##1} {#1} { false } }
        \int_incr:N \l__pf_keyword_int
      }
    \par
    \group_end:
  }
\cs_new_protected:Npn \__pf_keyword:nnn #1 #2 #3
  {
    \settowidth \pf@keywordtext { \ttfamily #1 }
    \str_if_eq:nnTF {#3} { true }
      { \tikzset { pf~keyword~state/.style = { alt={<#2>{opacity=\pf@keywordunused}{}} } } }
      { \tikzset { pf~keyword~state/.style = { } } }
    \begin{tikzpicture}[baseline=(k.base)]
      \begin{scope}[transparency~group, pf~keyword~state]
        \node[fill=colorHeading!\pf@keywordtint!colorBg, rounded~corners=\pf@smallradius, inner~xsep=\slideem{\pf@keywordpaddingx*\pf@keywordsize},
          inner~ysep=\slideem{\pf@keywordpaddingy*\pf@keywordsize}, minimum~width=\pf@keywordwidth,
          text~width=\dim_eval:n { \pf@keywordwidth - 2\slideem{\pf@keywordpaddingx*\pf@keywordsize} },
          anchor=base~west, text=colorCodeKeyword, font=\ttfamily] (k) at (0,0) {\strut #1};
        \str_if_eq:nnT {#3} { true }
          {
            \draw[paletteRed, line~width=\pf@hairline, visible~on=<#2>]
              ([xshift=\slideem{\pf@keywordpaddingx*\pf@keywordsize}, yshift=0.3em]k.base~west) -- ++(\pf@keywordtext,0);
          }
      \end{scope}
