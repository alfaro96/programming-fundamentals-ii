% Visual theme of the Programming Fundamentals II slides.
% Edit the values under "Deck geometry", "Palette" and the size sections; the rest consumes them.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style}[2026/11/03 Programming Fundamentals II beamer theme]

% Already in a recent LaTeX kernel; loaded for an older one, which lacks them
\RequirePackage{xparse}
\RequirePackage{xfp}
\RequirePackage{fontspec}
\RequirePackage{varwidth}
\RequirePackage{tikz}
\usetikzlibrary{calc, positioning, arrows.meta, fit}
\RequirePackage{colortbl}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}

% % % % % % % % % % Deck geometry % % % % % % % % % %
% Sizes are px of a 1920 px wide canvas, so one px is the page width over 1920 (a 16:9 page is 160 x 90 mm).
\newdimen\pf@px
\pf@px=\dimexpr\paperwidth/1920\relax
\newcommand\px[1]{\dimexpr\fpeval{#1}\pf@px\relax} % a length in canvas px, e.g. \px{75}

\newdimen\pf@em
\pf@em=47\pf@px % slide font size: every em below is of this
\newcommand\slideem[1]{\dimexpr\fpeval{#1}\pf@em\relax} % a length in slide ems, e.g. \slideem{0.6}

% Font size in slide ems and line height as a factor of it, e.g. \slidefont{0.48}{1.35}
\newcommand\slidefont[2]{%
  \fontsize{\the\dimexpr\fpeval{#1}\pf@em\relax}{\the\dimexpr\fpeval{(#1)*(#2)}\pf@em\relax}\selectfont}
% The same in canvas px, for the cover
\newcommand\pxfont[2]{%
  \fontsize{\the\dimexpr\fpeval{#1}\pf@px\relax}{\the\dimexpr\fpeval{(#1)*(#2)}\pf@px\relax}\selectfont}

\newdimen\pf@gutterx
\pf@gutterx=75\pf@px % side gutter on every slide, cover included
\newdimen\pf@hairline
\pf@hairline=2\pf@px % table and code block lines
\newdimen\pf@accentrule
\pf@accentrule=4\pf@px % the contents discs' rings
\newdimen\pf@radius
\pf@radius=10\pf@px % the rounded corners of every box: cards, code, flow boxes, the toolbox
\newdimen\pf@smallradius
\pf@smallradius=6\pf@px % the same for small boxes: tools and keywords
\newdimen\pf@arrowline
\pf@arrowline=3\pf@px % the arrows of the diagrams

% % % % % % % % % % Palette % % % % % % % % % %
% In palette.tex, shared with the statements
\input{palette}

% % % % % % % % % % Typography % % % % % % % % % %
% One family for headings and body (Inter, from the TeX distribution) and JetBrains Mono for code,
% in its NL cut: no ligatures, so comment marks, != or -> show the characters students type.
% \bfseries is SemiBold (600, headings and key words); fontseries eb is Bold (700, the cover).
\setsansfont{Inter}[
  Extension = .otf,
  UprightFont = *-Regular,
  ItalicFont = *-Italic,
  BoldFont = *-SemiBold,
  BoldItalicFont = *-SemiBoldItalic,
  FontFace = {eb}{n}{*-Bold}]
\input{codefont} % JetBrains Mono, from fonts/, shared with the statements
\newcommand\heavyseries{\fontseries{eb}\selectfont}
\usefonttheme{professionalfonts}

% Slide title and subtitle
\newcommand\pf@titlesize{1.25}
\newcommand\pf@subtitlesize{0.9}
\newcommand\pf@subtitlegap{0.2} % title to subtitle, em of the title
\newcommand\pf@lineheightheading{1.2}
\newcommand\pf@lineheightbody{1.4}
\newdimen\pf@titletop
\pf@titletop=65\pf@px % page edge to the title: a 75 px gutter, less the leading beamer already leaves

% Slide number
\newcommand\pf@numbersize{0.5}
\newdimen\pf@numberoffset
\pf@numberoffset=24\pf@px % from the right and bottom edges of the page

% Cover type sizes and spacing, in canvas px
\newcommand\pf@coversizecourse{50}
\newcommand\pf@coversizetitle{76}
\newcommand\pf@coversizesubtitle{60}
\newcommand\pf@coversizeauthor{38}
\newcommand\pf@coversizedegree{42}
\newcommand\coverlinecourse{\pxfont{\pf@coversizecourse}{1.2}\heavyseries\color{colorCoverCourse}}
\newcommand\coverlinetitle{\pxfont{\pf@coversizetitle}{1.2}\heavyseries\color{colorHeading}}
\newcommand\coverlinesubtitle{\pxfont{\pf@coversizesubtitle}{1.2}\heavyseries\color{colorMuted}}
\newcommand\coverlineauthor{\pxfont{\pf@coversizeauthor}{1.2}\heavyseries\color{colorCoverAuthor}}
\newcommand\coverlinedegree{\pxfont{\pf@coversizedegree}{1.2}\heavyseries\color{colorCoverDegree}}
\newcommand\covercoursegap{\px{75}} % course name to title
\newcommand\covertitlegap{\px{11}} % title to subtitle
\newcommand\covermetagap{\px{250}} % subtitle to author block
\newcommand\coverauthorgap{\px{15}} % author to degree

% Contents slide
\newcommand\pf@contentsdim{0.25} % opacity of the other sections
\newcommand\pf@contentsnumbertext{0.6} % the figure in each disc, em of the slide
\newcommand\pf@contentsnumbersize{2.6} % the disc, em of that figure
\newcommand\pf@contentsnumbergap{0.6} % disc to the section title, em of the slide

% Rule cards
\newcommand\pf@rulesgap{0.6} % between cards, em of the slide
\newcommand\pf@ruletextsize{0.48}
\newcommand\pf@ruletitlesize{0.6} % 1.25 em of the sentence under it
\newcommand\pf@ruletitlegap{0.25} % title to its sentence, em of the title
\newcommand\pf@rulepaddingy{0.4} % em of the slide
\newcommand\pf@rulepaddingx{0.6}
\newcommand\pf@ruletint{6} % card background, percent of its tone

% Numbered marks on code lines and the notes they point to
\newcommand\pf@markdisc{1.3} % the disc's diameter, em of the text beside it
\newcommand\pf@marknumber{0.72} % its number, em of that text
\newcommand\pf@digitheight{0.727} % Inter's digits over the baseline, em of the font
\newcommand\pf@codenotegap{0.4} % the disc to the note's title, em of the slide
\newcommand\pf@codenotetitlegap{0.3} % the disc and title to the text under them
\newcommand\pf@codenotecolumngap{1.4} % between notes: with no background, they need more than cards
\newcommand\pf@codenoterowgap{1.3} % between rows of notes

% Takeaway at the bottom of a slide
\newcommand\pf@notesize{0.58}
\newcommand\pf@notepaddingy{0.5} % em of the takeaway text
\newcommand\pf@notepaddingx{0.9}

% Code
\newcommand\pf@codesize{0.62}
\newcommand\pf@codecompactsize{0.47} % long lines or many: fits with no scrolling
\newcommand\pf@codedensesize{0.4} % a whole class next to more code
\newcommand\pf@codetightsize{0.36} % two whole classes side by side, with their notes under them
\newcommand\pf@codesnippetsize{0.33} % under a flow box, one column wide: a glimpse of a file, a console
\newcommand\pf@codelineheight{1.5}
\newcommand\pf@codepaddingy{0.9} % em of the code
\newcommand\pf@codepaddingx{1.1}
\newcommand\pf@codenumberwidth{1.2} % the line numbers' column, em of the code
\newcommand\pf@codenumbergap{1} % line number to code, em of the code
\newcommand\pf@codeedgetint{45} % a block's border, percent of its tone
\newcommand\pf@codedim{0.6} % how much the lines out of focus fade: they keep 40% of their ink
\newcommand\pf@blocktitlesize{0.55} % a file or column name over a block
\newcommand\pf@blocktitlegap{0.3} % that name to its block, em of the slide

% % % % % % % % % % Base % % % % % % % % % %
% Lines exactly one line height apart, even where inline code (taller than Inter) shares the line;
% for code, cards, takeaways and tools, and what the highlight bands assume
\newcommand\pf@linegrid{\lineskiplimit=-16000pt\relax\lineskip=0pt\relax}
\protected\def\pf@nohyphens{\hyphenpenalty=10000\relax} % whole words in notes and labels, never hyphenated
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=\pf@gutterx, text margin right=\pf@gutterx}

\setbeamercolor{normal text}{fg=colorText, bg=colorBg}
\setbeamercolor{background canvas}{bg=colorBg}
\setbeamercolor{structure}{fg=colorHeading}
\setbeamercolor{alerted text}{fg=colorAccent}
\setbeamercolor{frametitle}{fg=colorHeading}
\setbeamercolor{framesubtitle}{fg=colorMuted}

% Links: just the color, no box
\hypersetup{hidelinks}
\let\pf@href\href
\renewcommand\href[2]{\pf@href{#1}{\textcolor{colorAccentTwo}{#2}}}

% Lists: the marker in the accent
\setbeamertemplate{itemize item}{\textcolor{colorAccent}{\textbullet}}
\setbeamertemplate{itemize subitem}{\textcolor{colorAccent}{\textbullet}}
\setbeamertemplate{enumerate item}{\textcolor{colorAccent}{\insertenumlabel.}}
\setlength{\leftmargini}{\slideem{1.2}}
\addtobeamertemplate{itemize/enumerate body begin}{\setlength{\itemsep}{\slideem{0.35}}}{}

% % % % % % % % % % Title, subtitle and slide number % % % % % % % % % %
% Slide number: just the figure, bottom right, in the subtitle gray
\setbeamertemplate{footline}{%
  \hfill{\slidefont{\pf@numbersize}{1}\bfseries\color{colorMuted}\insertframenumber}%
  \hspace{\pf@numberoffset}\vspace{\pf@numberoffset}}

\setbeamertemplate{frametitle}{%
  \vskip\pf@titletop
  {\slidefont{\pf@titlesize}{\pf@lineheightheading}\bfseries\color{colorHeading}\insertframetitle\par}%
  \ifx\insertframesubtitle\@empty\else
    \vskip\slideem{\pf@subtitlegap*\pf@titlesize}%
    {\slidefont{\pf@subtitlesize}{\pf@lineheightheading}\bfseries\color{colorMuted}%
      \insertframesubtitle\par}%
  \fi}

% % % % % % % % % % Contents slide % % % % % % % % % %
% Before every section: the unit title, "Contents" and the sections, each numbered in a disc.
% The section about to start in the accent, the ones already seen filled, the rest an outline.
\AtBeginSection[]{%
  \begin{frame}{\inserttitle}{\contentstitle}
    \tableofcontents[currentsection] % with no subsections, beamer spaces the sections evenly
  \end{frame}}

% #1: the disc's colors; #2: opacity; #3: the title's weight
\newcommand\pf@tocitem[3]{%
  \begin{tikzpicture}[baseline=(title.base)]
    \begin{scope}[transparency group, opacity=#2]
      \node[circle, inner sep=0pt, line width=\pf@accentrule,
        minimum size=\slideem{\pf@contentsnumbertext*\pf@contentsnumbersize},
        font=\slidefont{\pf@contentsnumbertext}{1}\heavyseries, #1] (disc) {\inserttocsectionnumber};
      \node[anchor=west, inner sep=0pt, text=colorContentsText, font=\slidefont{1}{\pf@lineheightbody}#3]
        (title) at ([xshift=\slideem{\pf@contentsnumbergap}]disc.east) {\inserttocsection};
    \end{scope}
  \end{tikzpicture}}

\setbeamertemplate{section in toc}{%
  \pf@tocitem{fill=colorContentsCurrent, draw=colorContentsCurrent, text=colorBg}{1}{\heavyseries}}
\setbeamertemplate{section in toc shaded}{%
  \ifnum\inserttocsectionnumber<\value{section}%
    \pf@tocitem{fill=colorContentsNumber, draw=colorContentsNumber, text=colorBg}{\pf@contentsdim}{}%
  \else
    \pf@tocitem{draw=colorContentsNumber, text=colorContentsNumber}{\pf@contentsdim}{}%
  \fi}

% \begin{recap} \recapitem<step>{Section}{Sentence} ... \end{recap}: the unit's summary, drawn as its
% contents: every section dimmed on entry; on its step one turns the accent, as the section about to
% start, with its sentence beside it, and on the next step it is filled, as the ones already seen
\newcommand\pf@recapnumber{0.5} % the figure in each disc, em of the slide; the disc as in the contents
\newcommand\pf@recaptitlesize{0.7}
\newcommand\pf@recaptitlewidth{12.8} % the column of section names, em of the slide: the longest name, unit 4's, on one line
\newcommand\pf@recaptextsize{0.58}
\newcommand\pf@recapgap{0.6} % disc to name, and name to sentence, em of the slide
\newcommand\pf@recaprowgap{0.45} % between sections
\newcount\pf@recapcount
\NewDocumentEnvironment{recap}{}{\par\global\pf@recapcount=0 }{\par}
\NewDocumentCommand\recapitem{ D<>{1} m m }{%
  \global\advance\pf@recapcount by 1
  \noindent\begin{tikzpicture}[every node/.append style={outer sep=0pt}] % so the row is exactly \linewidth
    \begin{scope}[transparency group, alt=<#1->{}{opacity=\pf@contentsdim}]
      \node[circle, inner sep=0pt, line width=\pf@accentrule,
        minimum size=\slideem{\pf@recapnumber*\pf@contentsnumbersize},
        font=\slidefont{\pf@recapnumber}{1}\heavyseries,
        text height=\slideem{\pf@digitheight*\pf@recapnumber}, text depth=0pt,
        draw=colorContentsNumber, text=colorContentsNumber, % ahead: an outline
        alt=<#1->{fill=colorContentsNumber, text=colorBg}{}, % seen: filled
        alt=<#1| handout:0>{fill=colorContentsCurrent, draw=colorContentsCurrent, text=colorBg}{}] % now: the accent
        (disc) {\the\pf@recapcount};
      \node[anchor=west, inner sep=0pt, text width=\slideem{\pf@recaptitlewidth}, align=left,
        text=colorContentsText, font=\slidefont{\pf@recaptitlesize}{1.2}\bfseries]
        (title) at ([xshift=\slideem{\pf@recapgap}]disc.east) {#2};
    \end{scope}
    \node[anchor=west, inner sep=0pt, align=left, text=colorText,
      text width=\dimexpr\linewidth-\slideem{\pf@recapnumber*\pf@contentsnumbersize+2*\pf@recapgap+\pf@recaptitlewidth}-\pf@accentrule\relax, % the disc's ring too
      font=\slidefont{\pf@recaptextsize}{1.35}\pf@linegrid\pf@nohyphens, visible on=<#1->]
      at ([xshift=\slideem{\pf@recapgap}]title.east) {#3};
  \end{tikzpicture}\par\vskip\slideem{\pf@recaprowgap}}

% % % % % % % % % % Callouts % % % % % % % % % %
% pf callout={border}{background}: a rounded box, its tone in the background and, if any, a hairline
% border (none for none); no side bar, which a rounded corner cannot follow. Cards and takeaways
\tcbset{
  pf callout/.style 2 args={
    enhanced, arc=\pf@radius, boxsep=0pt, colback=#2,
    /utils/exec={\def\pf@border{#1}\def\pf@none{none}},
    /utils/exec={\ifx\pf@border\pf@none\tcbset{frame hidden, boxrule=0pt}\else
      \tcbset{colframe=#1, boxrule=\pf@hairline}\fi}}}

% % % % % % % % % % Rule cards % % % % % % % % % %
% \begin{card}<overlay>[tone]{Title} One sentence. \end{card}; tone: info, warn, error, state, behavior
\tcbset{
  pf card/.style={
    pf callout={none}{tone@#1!\pf@ruletint!colorBg},
    left=\slideem{\pf@rulepaddingx}, right=\slideem{\pf@rulepaddingx},
    top=\slideem{\pf@rulepaddingy}, bottom=\slideem{\pf@rulepaddingy},
    fontupper=\slidefont{\pf@ruletextsize}{1.35}\color{colorText}\raggedright\pf@linegrid,
    before upper={\def\pf@cardtone{tone@#1}}}}

\newcommand\pf@cardtitle[1]{%
  {\slidefont{\pf@ruletitlesize}{1.2}\bfseries\color{\pf@cardtone}#1\par}%
  \vskip\slideem{\pf@ruletitlegap*\pf@ruletitlesize}}

% Shown from its step on, with beamer's own \uncover
\NewDocumentEnvironment{card}{ D<>{1-} O{info} m }{%
  \begin{uncoverenv}<#1>%
  \begin{tcolorbox}[pf card=#2,
    before upper app={\if\relax\detokenize{#3}\relax\else\pf@cardtitle{#3}\fi}]}
  {\end{tcolorbox}\end{uncoverenv}}

% \begin{cards}[columns] holds cards in columns of one width, a row of them as tall as the tallest
\NewDocumentEnvironment{cards}{ O{1} }{%
  \begin{tcbraster}[raster columns=#1, raster valign=top, raster equal height=rows,
    raster column skip=\slideem{\pf@rulesgap}, raster row skip=\slideem{\pf@rulesgap}]}
  {\end{tcbraster}}

% \blockgap between a block and the next one on the slide (code and its output, notes and a table);
% \notesgap, wider, between code and the notes or table that read it, so they show as two parts
\newcommand\pf@blockgap{0.6}
\newcommand\pf@notesgap{1.2}
\newcommand\blockgap{\par\vskip\slideem{\pf@blockgap}}
\newcommand\notesgap{\par\vskip\slideem{\pf@notesgap}}
% \boxrowgap between two box rows stacked one over the other, closer than between blocks, so they read
% as one list (e.g. "Comparing strings")
\newcommand\pf@boxrowgap{0.3}
\newcommand\boxrowgap{\par\vskip\slideem{\pf@boxrowgap}}
% \begin{boxrow} columns with a box in each (card, code, console) \end{boxrow}: every box in it as tall
% as the tallest, its content centered; tcolorbox measures them on the build before, as it does for cards
% The highlight bands and marks count lines from the top: no steps or marks on code in a boxrow
\newcount\pf@boxrownumber
\NewDocumentEnvironment{boxrow}{}{%
  \global\advance\pf@boxrownumber by 1
  \edef\pf@boxrowname{pf@boxrow\the\pf@boxrownumber}%
  \tcbset{every box/.append style={equal height group=\pf@boxrowname, valign=center}}}
  {}

% % % % % % % % % % Code notes % % % % % % % % % %
% A numbered disc, #1 the slide ems of the text beside it: on a code line (marks) and on its note
\tikzset{pf mark/.style={circle, inner sep=0pt, fill=colorHeading, text=colorBg,
  minimum size=\slideem{\pf@markdisc*#1}, font=\slidefont{\pf@marknumber*#1}{1}\bfseries,
  text height=\slideem{\pf@digitheight*\pf@marknumber*#1}, text depth=0pt}} % so the digit is what gets centered

% \begin{codenotes}[columns] \codenote<step>{Title}{Text} ... \end{codenotes}: what the marks of a
% code block point to, numbered in the same order; no background, so the code stays in front
\newcount\pf@codenotenumber
\NewDocumentEnvironment{codenotes}{ O{3} }{%
  \global\pf@codenotenumber=0
  \begin{tcbraster}[raster columns=#1, raster valign=top, raster column skip=\slideem{\pf@codenotecolumngap},
    raster row skip=\slideem{\pf@codenoterowgap}]}
  {\end{tcbraster}}
% \codenote<step>[tone]{Title}{Text}, tone as a card's (state, behavior, error...); \codenote* has no
% number, for a note about the block that points at no line in it
\NewDocumentCommand\codenote{ s D<>{1-} O{info} m m }{%
  \IfBooleanF{#1}{\global\advance\pf@codenotenumber by 1 }%
  \begin{uncoverenv}<#2>%
  \begin{tcolorbox}[blank, fontupper=\slidefont{\pf@ruletextsize}{1.35}\color{colorText}\raggedright\pf@linegrid]
    {\slidefont{\pf@ruletitlesize}{1.2}\bfseries\color{tone@#3}%
     \IfBooleanF{#1}{\tikz[baseline=(pf@mark.base)]\node[pf mark=\pf@ruletitlesize, fill=tone@#3] (pf@mark)
       {\the\pf@codenotenumber};\hspace{\slideem{\pf@codenotegap}}}%
     #4\par}%
    \if\relax\detokenize{#5}\relax\else % an empty text: a note that is only its title
      \vskip\slideem{\pf@codenotetitlegap}%
      #5
    \fi
  \end{tcolorbox}%
  \end{uncoverenv}}

% % % % % % % % % % Changed values % % % % % % % % % %
% \highlight{text}: a value the slide points at, in bold and in the color of emphasis; not tinted, which in
% a phone or a diagram would read as one more box. \changed<step>{old}{new}: old until the step, then new,
% highlighted. \marked<step>{text}: the same text, highlighted from the step
\newcommand\highlight[1]{\textbf{\color{colorAccent}#1}}
\NewDocumentCommand\changed{ D<>{2-} m m }{\alt<#1>{\highlight{#3}}{#2}}
\NewDocumentCommand\marked{ D<>{2-} m }{\alt<#1>{\highlight{#2}}{#2}}

% % % % % % % % % % Phones % % % % % % % % % %
% \begin{phones}[size] \phone[keys] ... \end{phones}: the bank's app on a row of phones, centered;
% size is normal, large (alone on the slide) or small (under captions). The keys, all optional:
% holder, initials, iban, balance and rate, the values (\changed and \marked work in them); template,
% the empty screen of the class, with slots for the data; tones, an object's data in the tone of data
% and its buttons in that of operations, as in the template; rate on, lock on (a padlock by the IBAN) and
% tap on (Deposit pressed), the step each shows from; data mark and operations mark, a numbered disc in
% the tone of data or of operations by each piece of data (photo, holder, account) or by the buttons,
% with data mark on and operations mark on for its step. \phonegroup<step>{Title}{Caption}{phones} sets phones under a caption, and
% \phonearrow<step> an arrow between groups
\newdimen\pf@u % one unit of the phone: an em of the slide at small size
\newcommand\pf@phonescale{1}
\newcommand\pf@phonewidth{4.6} % in units: an iPhone 16 Pro, 71.5 by 149.6 mm
\newcommand\pf@phoneheight{9.6}
\newcommand\pf@phonegap{1.2} % between phones, em of the slide
\newcommand\pf@phonearrowlength{2.2}
\newcommand\pf@phonetitlegap{0.2} % a group's title to its caption
\newcommand\pf@phonecaptiongap{0.7} % that caption to the phones
\newif\ifpf@phonefirst
\NewDocumentEnvironment{phones}{ O{normal} }{%
  \par\begin{center}%
  \csname pf@phonesize@#1\endcsname
  \pf@u=\slideem{\pf@phonescale}\relax
  \global\pf@phonefirsttrue}
  {\end{center}}
\newcommand\pf@phonesize@normal{\renewcommand\pf@phonescale{1.25}}
\newcommand\pf@phonesize@large{\renewcommand\pf@phonescale{1.5}}
\newcommand\pf@phonesize@small{\renewcommand\pf@phonescale{1}}
\newcommand\pf@phonesep{\ifpf@phonefirst\global\pf@phonefirstfalse\else\hspace{\slideem{\pf@phonegap}}\fi}

\pgfkeys{/pf/phone/.is family, /pf/phone,
  holder/.store in=\pf@ph@holder, initials/.store in=\pf@ph@initials, iban/.store in=\pf@ph@iban,
  balance/.store in=\pf@ph@balance, rate/.store in=\pf@ph@rate,
  rate on/.store in=\pf@ph@rateon, lock on/.store in=\pf@ph@lockon, tap on/.store in=\pf@ph@tapon,
  template/.code={\let\ifpf@ph@template\iftrue\let\ifpf@ph@tones\iftrue}, tones/.code={\let\ifpf@ph@tones\iftrue},
  data mark/.store in=\pf@ph@datamark, data mark on/.store in=\pf@ph@datamarkon,
  operations mark/.store in=\pf@ph@opsmark, operations mark on/.store in=\pf@ph@opsmarkon}
\newcommand\pf@phonedefaults{%
  \let\ifpf@ph@template\iffalse\let\ifpf@ph@tones\iffalse
  \def\pf@ph@holder{}\def\pf@ph@initials{}\def\pf@ph@iban{}\def\pf@ph@balance{}\def\pf@ph@rate{}%
  \def\pf@ph@rateon{1-}\def\pf@ph@lockon{}\def\pf@ph@tapon{}%
  \def\pf@ph@datamark{}\def\pf@ph@datamarkon{1-}\def\pf@ph@opsmark{}\def\pf@ph@opsmarkon{1-}}
\newcommand\pf@phfont[2]{\slidefont{#1*\pf@phonescale}{#2}} % a size in units
\newcommand\pf@phonebuttonsize{0.25} % the text on the buttons, in units
\tikzset{
  pf phone text/.style={inner sep=0pt, outer sep=0pt, anchor=base west, text=colorText},
  pf phone button text/.style={inner sep=0pt, font=\pf@phfont{\pf@phonebuttonsize}{1}\bfseries, % as tall as its capitals,
    text height=\slideem{\pf@digitheight*\pf@phonebuttonsize*\pf@phonescale}, text depth=0pt}, % so they are what gets centered
  pf phone slot/.style={inner xsep=0.14\pf@u, inner ysep=0.08\pf@u, outer sep=0pt, anchor=base west,
    draw=colorState!60!colorBg, line width=0.025\pf@u, fill=colorState!8!colorBg, rounded corners=0.12\pf@u,
    text=colorState}}
\newcommand\pf@phoneslot[3]{% at #1, the placeholder #2, in #3: the font of the value it stands for
  \node[pf phone slot, font=#3] at #1 {#2};}

% The phone itself, for every app: side buttons (action and volume on the left, power and camera control on
% the right), the frame with its thin even bezel, the screen, the Dynamic Island, the status bar and the
% home indicator; inside a phone's picture, in its units
\newcommand\pf@phoneshell{%
  \colorlet{pf@phonebody}{colorText!88!colorBg}%
    \begin{scope}[pf@phonebody, rounded corners=0.03\pf@u]
      \fill (-0.05,-1.45) rectangle (0.02,-1.85);
      \fill (-0.05,-2.2) rectangle (0.02,-2.95);
      \fill (-0.05,-3.15) rectangle (0.02,-3.9);
      \fill (\pf@W-0.02,-2.45) rectangle (\pf@W+0.05,-3.6);
      \fill (\pf@W-0.02,-5.6) rectangle (\pf@W+0.05,-6.25);
    \end{scope}
    \fill[pf@phonebody, rounded corners=0.8\pf@u] (0,0) rectangle (\pf@W,-\pf@H);
