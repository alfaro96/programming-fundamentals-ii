// reveal-md settings, read once at startup: restart npm run dev after a change
{
  // A line with only -- starts a vertical sub-slide (--- starts a new slide)
  "verticalSeparator": "\r?\n--\r?\n",

  // Base theme for code highlighting; theme/custom.css recolors it with the palette
  "highlightTheme": "github",

  // Options passed to reveal.js
  "revealOptions": {
    // The canvas: the slides, the PDF pages and the screenshots all take this size
    "width": 1920,
    "height": 1080,

    // How much a slide may be enlarged on a big screen
    "maxScale": 4,

    // Slides start at the top; covers center themselves
    "center": false,

    // Slides change at once, with no animation
    "transition": "none",

    // PDF: every step of a slide on one page (the class PDF turns it on)
    "pdfSeparateFragments": false,

    // No frame around the slide, so a PDF page is exactly the canvas
    "margin": 0
  },

  // Loaded in every unit, in order: cover.js first (the others read it), the plugin before draw.js
  "scripts": "theme/cover.js,theme/contents.js,theme/handout.js,theme/vendor/chalkboard/plugin.js,theme/draw.js",

  // The page around the slides: reveal-md's template plus viewport-fit=cover, for tablets
  "template": "theme/reveal.html",

  // Extra stylesheets: the chalkboard plugin's own, which theme/custom.css adjusts
  "css": "theme/vendor/chalkboard/style.css",

  // Copied into every export: the images of the units
  "staticDirs": "content/assets"
}
